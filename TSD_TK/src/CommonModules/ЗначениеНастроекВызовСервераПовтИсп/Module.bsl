// Истина, если заполнены обязательные параметры учета:
// наименование организации, ИНН и система налогообложения.
//
// Возвращаемое значение:
//   Булево   - Ложь, если хотя бы один из параметров не заполнен.
//
Функция ЗаполненыПараметрыУчета() Экспорт
	
	АвтономныйРежим =  ЗначениеНастроекВызовСервераПовтИсп.ЭтоАвтономныйРежим() ИЛИ НЕ ЗначениеНастроекВызовСервераПовтИсп.УстановленРежимСинхронизации();

	ВсегоПараметров = 0;
	Если ЗначениеНастроекПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьПриемТоваров")= Истина И НЕ АвтономныйРежим Тогда
		ВсегоПараметров = ВсегоПараметров + 1;
	КонецЕсли;
	
	Если  ЗначениеНастроекПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьСписаниеТоваров")= Истина И НЕ АвтономныйРежим Тогда
		ВсегоПараметров = ВсегоПараметров + 1;
	КонецЕсли;
	
	Если  ЗначениеНастроекПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьПроверкуЦен")= Истина И НЕ АвтономныйРежим Тогда
		ВсегоПараметров = ВсегоПараметров + 1;
	КонецЕсли;
	
	Если  ЗначениеНастроекПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьПеремещениеТоваров")= Истина И НЕ АвтономныйРежим Тогда
		ВсегоПараметров = ВсегоПараметров + 1;
	КонецЕсли;
	
	Если  ЗначениеНастроекПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьИнвентаризациюТоваров")= Истина И НЕ АвтономныйРежим Тогда
		ВсегоПараметров = ВсегоПараметров + 1;
	КонецЕсли;
	Если  ЗначениеНастроекПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьЗаказыКлиентов")= Истина И НЕ АвтономныйРежим Тогда
		ВсегоПараметров = ВсегоПараметров + 1;
	КонецЕсли;
	Если  ЗначениеНастроекПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьЖурналДокументов")= Истина И НЕ АвтономныйРежим Тогда
		ВсегоПараметров = ВсегоПараметров + 1;
	КонецЕсли;
	
	Если  ЗначениеНастроекПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьЗаказыКлиентов")= Истина И АвтономныйРежим Тогда
		ВсегоПараметров = ВсегоПараметров + 1;
	КонецЕсли;

	Если  ЗначениеНастроекПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьУценкуТовара")= Истина И НЕ АвтономныйРежим Тогда
		ВсегоПараметров = ВсегоПараметров + 1;
	КонецЕсли;

	Если  ЗначениеНастроекПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьИнвентаризацияКоммисия")= Истина И НЕ АвтономныйРежим Тогда
		ВсегоПараметров = ВсегоПараметров + 1;
	КонецЕсли;
	
	Если  ЗначениеНастроекПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьПереоценки")= Истина И НЕ АвтономныйРежим Тогда
		ВсегоПараметров = ВсегоПараметров + 1;
	КонецЕсли;
	Если  ЗначениеНастроекПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьЗадачи")= Истина И НЕ АвтономныйРежим Тогда
		ВсегоПараметров = ВсегоПараметров + 1;
	КонецЕсли;
	Если  ЗначениеНастроекПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьМенеджерТЗ")= Истина И НЕ АвтономныйРежим Тогда
		ВсегоПараметров = ВсегоПараметров + 1;
	КонецЕсли;
	Если  ЗначениеНастроекПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьСканировкаТабака")= Истина И НЕ АвтономныйРежим Тогда
		ВсегоПараметров = ВсегоПараметров + 1;
	КонецЕсли;
	
	Если  ЗначениеНастроекПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьПечатьНаПринтер")= Истина И НЕ АвтономныйРежим Тогда
		ВсегоПараметров = ВсегоПараметров + 1;
	КонецЕсли;
   	Если  ЗначениеНастроекПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьЛогистика")= Истина И НЕ АвтономныйРежим Тогда
		ВсегоПараметров = ВсегоПараметров + 1;
	КонецЕсли;
	
	Если  ЗначениеНастроекПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьКонтролера")= Истина И НЕ АвтономныйРежим Тогда
		ВсегоПараметров = ВсегоПараметров + 1;
	КонецЕсли;


	
	
	Если ВсегоПараметров = 0 Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

