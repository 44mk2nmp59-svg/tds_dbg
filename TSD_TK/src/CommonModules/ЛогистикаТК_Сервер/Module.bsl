#Область ПрограммныйИнтерфейс

// Получает данные перемещения по UUID документа через GET-запрос к серверу логистики.
//
// Параметры:
//   Документ_UUID - Строка - идентификатор (UUID) документа перемещения
//
// Возвращаемое значение:
//   Произвольный - результат выполнения GET-запроса, сформированный функцией КомплектовщикТК.ПодготовитьGETЗапрос
Функция ПолучитьДанныеПеремещения(Документ_UUID) Экспорт

    ТекстЗапроса = "/Logistika/"+ПараметрыСеанса.UUID+"/PF?uuidcom="+ПараметрыСеанса.Сотрудник_ID+"&chk="+Документ_UUID;

    РезОтвет = КомплектовщикТК.ПодготовитьGETЗапрос(ТекстЗапроса);

    Возврат РезОтвет;

КонецФункции

#КонецОбласти