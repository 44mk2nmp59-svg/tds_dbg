#Область ПрограммныйИнтерфейс

// Возвращает данные PKG на разборочной карте по штрихкоду
//
// Параметры:
//   ШтрихКод - Строка - штрихкод товара
//
// Возвращаемое значение:
//   Структура:
//     * Результат - Булево - результат выполнения операции
//     * ОписаниеОшибки - Строка - описание ошибки, если она возникла
//     * Ответ - Структура - ответ от сервиса при успешном выполнении
//           - Строка - при ошибке
Функция ПолучитьДанныеPKG_На_РК(ШтрихКод) Экспорт

    ТекстЗапроса = "/Roznitsa/" + ПараметрыСеанса.UUID + "/PKG_RK?uuidcom=" + ПараметрыСеанса.Сотрудник_ID + "&chk="
        + ШтрихКод;
    РезОтвет = КомплектовщикТК.ПодготовитьGETЗапрос(ТекстЗапроса, "Дата");

    Возврат РезОтвет;

КонецФункции

// Возвращает данные PKG из системы розничной торговли для указанного штрихкода.
//
// Параметры:
//   ШтрихКод - Строка - штрихкод товара
//   БезТоваров - Булево - признак получения данных без товаров. Истина - данные без товаров, Ложь - полные данные. По умолчанию Ложь
//
// Возвращаемое значение:
//   Структура:
//     * Результат - Булево - результат выполнения операции
//     * ОписаниеОшибки - Строка - описание ошибки, если она возникла
//     * Ответ - Структура - ответ от сервиса при успешном выполнении
//           - Строка - при ошибке
Функция ПолучитьДанныеPKG(ШтрихКод, БезТоваров = Ложь) Экспорт

    ТекстЗапроса = "/Roznitsa/" + ПараметрыСеанса.UUID + "/PKG?uuidcom=" + ПараметрыСеанса.Сотрудник_ID + "&chk="
        + ШтрихКод + "&aktsep=" + ?(БезТоваров, "0", "1");
    РезОтвет = КомплектовщикТК.ПодготовитьGETЗапрос(ТекстЗапроса, "Дата");

    Возврат РезОтвет;

КонецФункции

// Выгружает документ приемки распределительного центра на сервер через HTTP-запрос.
//
// Параметры:
//   СтруктураДокумент - Структура - данные документа для выгрузки
//   БезТоваров - Булево - признак выгрузки без товаров
//
// Возвращаемое значение:
//   Структура:
//     * Результат - Булево - результат выполнения операции
//     * ОписаниеОшибки - Строка - описание ошибки, если она возникла
//     * Ответ - Структура - ответ от сервиса при успешном выполнении
//           - Строка - при ошибке
Функция ВыгрузитьДокументПриемРЦ(СтруктураДокумент, БезТоваров = Ложь) Экспорт

    ТекстЗапроса = "/Roznitsa/" + ПараметрыСеанса.UUID + "/PKGloadRC" + "?aktsep=" + ?(БезТоваров, "0", "1");
    РезОтвет = КомплектовщикТК.ОтправитьНаСервер(СтруктураДокумент, ТекстЗапроса);

    Возврат РезОтвет;

КонецФункции

// Получает список документов PKG через GET-запрос к сервису розницы в зависимости от типа документа
//
// Параметры:
//   ТипДокумента - СправочникСсылка.ТипыДокументов - тип документа, определяющий значение параметра bpPKG
//
// Возвращаемое значение:
//   см. КомплектовщикТК.ПодготовитьGETЗапрос
Функция ПолучитьСписокДокументовPKG(ТипДокумента) Экспорт

    Если ТипДокумента = Справочники.ТипыДокументов.БезакцептныйПриемPKG Тогда
        ТекстЗапроса = "/Roznitsa/" + ПараметрыСеанса.UUID + "/PKGRC?uuidcom=0&bpPKG=1";
    Иначе
        ТекстЗапроса = "/Roznitsa/" + ПараметрыСеанса.UUID + "/PKGRC?uuidcom=0&bpPKG=0";
    КонецЕсли;

    РезОтвет = КомплектовщикТК.ПодготовитьGETЗапрос(ТекстЗапроса, "Дата");

    Возврат РезОтвет;

КонецФункции

// Завершает задачу на просмотр анкеты в розничном торговом киоске.
//
// Параметры:
//   ИД_Задача - Строка - идентификатор задачи
//
// Возвращаемое значение:
//   см. КомплектовщикТК.ПодготовитьGETЗапрос
Функция ЗавершитьЗаданиеПросмотрАнкеты(ИД_Задача) Экспорт

    ТекстЗапроса = "/Roznitsa/" + ПараметрыСеанса.UUID + "/anketa?uuidcom=" + ПараметрыСеанса.Сотрудник_ID + "&uuidz="
        + ИД_Задача;
    РезОтвет = КомплектовщикТК.ПодготовитьGETЗапрос(ТекстЗапроса);

    Возврат РезОтвет;

КонецФункции

// Получает данные для печати выдачи ДС в розничном торговом киоске.
//
// Параметры:
//   ИД_Задача - Строка - идентификатор задачи
//
// Возвращаемое значение:
//   см. КомплектовщикТК.ПодготовитьGETЗапрос
Функция ПолучитьДанныеПечатиВыдачиДС(ИД_Задача) Экспорт

    ТекстЗапроса = "/Roznitsa/" + ПараметрыСеанса.UUID + "/pvds?uuidcom=" + ПараметрыСеанса.Сотрудник_ID + "&uuidz="
        + ИД_Задача;
    РезОтвет = КомплектовщикТК.ПодготовитьGETЗапрос(ТекстЗапроса);

    Возврат РезОтвет;

КонецФункции

// Отправляет токен на сервер
//
// Параметры:
//   ID_Устройства - Строка - идентификатор устройства
//   Модель - Строка - модель устройства
//   Токен - Строка - токен
//
// Возвращаемое значение:
//   Структура:
//     * Результат - Булево - результат выполнения операции
//     * ОписаниеОшибки - Строка - описание ошибки, если она возникла
//     * Ответ - Структура - ответ от сервиса при успешном выполнении
//           - Строка - при ошибке
Функция ОтправитьТокенНаСервер(ID_Устройства, Модель, Токен) Экспорт

    СтруктураДокумент = Новый Структура;
    СтруктураДокумент.Вставить("token", Токен);
    СтруктураДокумент.Вставить("device_id", ID_Устройства);
    СтруктураДокумент.Вставить("model", Модель);

    ТекстЗапроса = "/Roznitsa/" + ПараметрыСеанса.UUID + "/token?uuidcom=0";
    РезОтвет = КомплектовщикТК.ОтправитьНаСервер(СтруктураДокумент, ТекстЗапроса);

    Возврат РезОтвет;

КонецФункции

#КонецОбласти