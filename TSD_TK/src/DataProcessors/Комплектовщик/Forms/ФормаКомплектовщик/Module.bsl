&НаКлиенте
Асинх Процедура ЗакончитьОтборАсинх()
    Режим = РежимДиалогаВопрос.ДаНет;
    Ответ = Ждать ВопросАсинх("Сформувати документ?", Режим, 0);
    Если Ответ = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;  
	//ОтправитьНапечатьЧекрезерв(ДокументUUID);
	ИД_Статус = 2;
	РезультатВыгрузки = ВыгрузитьРезультатыСканирования();
	Если НЕ РезультатВыгрузки.Результат Тогда
		Возврат;
	КонецЕсли;
	
	Если  ЗначениеНастроекВызовСервераПовтИсп.ИспользуетсяПечатьНаПринтер() Тогда
		мПечатнаяФорма = Неопределено;	
		РезультатВыгрузки.Ответ.Свойство("ПечатнаяФорма",мПечатнаяФорма);
		
		Если мПечатнаяФорма = Неопределено Тогда
			Возврат;	
		Иначе  
			
			Если ТипЗнч(мПечатнаяФорма)= Тип("Массив") Тогда
				
				Для Каждого СтрукПечФомра Из мПечатнаяФорма Цикл 
					
					
					РезПечать =  ИнтеграцияТК_ВызовСервера.ЗапросПечатнаяФорма(СтрукПечФомра);
					
					Если РезПечать.Результат Тогда
						ОбщегоНазначенияКлиент.ВывестиПДФ_НаПечать(РезПечать.Ответ);
					Иначе
						Сообщить(РезПечать.ОписаниеОшибки);
					КонецЕсли; 
					
					
				КонецЦикла;
				
				
			КонецЕсли;
			
			
			
		КонецЕсли;
	КонецЕсли;	
	
	
КонецПроцедуры

