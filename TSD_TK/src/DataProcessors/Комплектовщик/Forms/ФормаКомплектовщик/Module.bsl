	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаКнопкиОтменаОК,ГруппаРасхождения"+стрГрФорм, "Видимость", Ложь);	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаШапкаДокумента", "Видимость", Истина);
	Элементы.ГруппаШапкаДокумента.Скрыть();    
	
	ИД_Статус = 1;
