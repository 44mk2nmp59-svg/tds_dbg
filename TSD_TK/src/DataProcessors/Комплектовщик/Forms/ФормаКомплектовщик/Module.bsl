	ТекНаименованиеТовара = текСтрокаТовара.НаименованиеТовара;	
	ТекУпаковка	          = текСтрокаТовара.Упаковка; 
	ТекХарактеристика     = текСтрокаТовара.Характеристика;
	ТекиспХарактеристика  = текСтрокаТовара.испХарактеристика;
    ТекТележкаНомер       = ПолучитьНомераТележки();
	ТекПроизводитель      = текСтрокаТовара.Производитель;  //1-ФМ, 2-БАТ, 0-Все остальные
    ТекидУпаковка         = текСтрокаТовара.идУпаковка;    //1 - баз ед.изм (шт, пачки), 2 - Упакавка (блоки) , 3 - ящики, 0 - непонятные 
	
	РучнойВводБезШтрикода = Ложь;
	Если ТаблицаШтрихКода.НайтиСтроки(Новый Структура("Артикул",ТекАртикул)).Количество() = 0 и НЕ (ТекПроизводитель = 1 ИЛИ ТекПроизводитель = 2) Тогда
		ТекШтрихКодОтсканирован = Истина;  
		РучнойВводБезШтрикода = Истина;//нет штрихкодов ввод вручную
	Иначе
		
		ТекШтрихКодОтсканирован = текСтрокаТовара.ШтрихКодОтсканирован;   
	КонецЕсли;
	
	Если ТекиспХарактеристика = 1 Тогда
		 нстрокиМРЦ =  ТаблицаШтрихКодаПроизводителей.НайтиСтроки(Новый Структура("Артикул,Характеристика",ТекАртикул,ТекХарактеристика));
		 счМРЦ = 0; 
