	ПринтерОтсканированЗавершение(ПараметрыТараСтруктура);

КонецПроцедуры

	

&НаКлиенте
Процедура ОтсканироватьШтрихКодКороба(ПараметрыТараСтруктура)
	
	ПараметрыТараСтруктура.Вставить("НомерКороба",КоробкаНомер);
	ПараметрыТараСтруктура.Вставить("uuiddoc",ДокументПеремещениеUUID);

	ОповещениеТараОтсканирована = Новый ОписаниеОповещения("ОповещениеТараОтсканирована", ЭтотОбъект,ПараметрыТараСтруктура);
	ОткрытьФорму("ОбщаяФорма.ФормаСканироватьУпаковку",ПараметрыТараСтруктура,ЭтаФорма,,,,ОповещениеТараОтсканирована,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

КонецПроцедуры



&НаКлиенте
Процедура ОповещениеПринтерОтсканирован(Результат,ПараметрыКоробка)Экспорт
	
	ИдетПроцессСканированияПринтера = Ложь;
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СоздатьРаспечататьКоробку(Результат.ИД_Принтер,Результат.КоличествоСтикеров) Тогда
		
		Если ИспользоватьШоллер Тогда
			ОтсканироватьШтрихКодКороба(ПараметрыКоробка);
		Иначе  
			ПринтерОтсканированЗавершение(ПараметрыКоробка)
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОповещениеТЕ_Отсканирована(Результат,ПараметрыКоробка)Экспорт
	
	//Если Результат = Неопределено Тогда
	//	Возврат;
	//КонецЕсли;
	ТЕОстканирован = Истина;  
	
	СтрокаТТУ = ТаблицаТУ.Добавить();
	СтрокаТТУ.КоробкаНомер = КоробкаНомер;
	СтрокаТТУ.Размещено = Результат;
	
	ПринтерОтсканированЗавершение(ПараметрыКоробка);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПринтерОтсканированЗавершение(ПараметрыКоробка) 
	
	Если ИспользоватьТЕ И НЕ ТЕОстканирован Тогда
		
		ОповещениеТЕ_Отсканирована = Новый ОписаниеОповещения("ОповещениеТЕ_Отсканирована", ЭтотОбъект,ПараметрыКоробка);
		ОткрытьФорму("ОбщаяФорма.ФормаСканироватьТЕ",ПараметрыКоробка,ЭтаФорма,,,,ОповещениеТЕ_Отсканирована,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
	Иначе
		
		Если ПараметрыКоробка.Свойство("ПоследняяКоробка") Тогда 
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаКнопкаЗавершитьЗакрытьКоробку", "Видимость", Ложь);	
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаКнопкаЗак", "Видимость", Истина);	
		КонецЕсли;	
		КоробкаНомер = КоробкаНомер+1; 
		КоробкаДатаОткрыта = ТекущаяДата();
		ТЕОстканирован = Ложь;	
		ТекКоличествоВведеноВес = 0;
		ТекКоличествоВведено = 0;
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ЗакрытьКоробкуЗавершение(Команда)

	ВсегоВКоробке = ВсегоТекВведеноУпаковщик(Ложь,Истина);
	Если ВсегоВКоробке = 0 Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаКнопкаЗавершитьЗакрытьКоробку", "Видимость", Ложь);	
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаКнопкаЗак", "Видимость", Истина);	
		Возврат;
	КонецЕсли;
	ПараметрыСтруктура = Новый Структура;
    ПараметрыСтруктура.Вставить("ПоследняяКоробка");
	Если ТоваровВУпаковке(КоробкаНомер)  = 1 И ТипДокумента ="КомплектовщикОтбор" Тогда
		ПараметрыСтруктура.Вставить("ВводКоличества");
	КонецЕсли;

	ОповещениеПечатьКоробки = Новый ОписаниеОповещения("ОповещениеПринтерОтсканирован", ЭтотОбъект,ПараметрыСтруктура);
	ОткрытьФорму("ОбщаяФорма.ПечатьКоробки",ПараметрыСтруктура,ЭтаФорма,,,,ОповещениеПечатьКоробки,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаКлиенте
Процедура ВводШКПриИзменении(Элемент)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма", ЭтаФорма);  
	
	ОбработатьПолученныйШтрихкод(ВводШК, ДополнительныеПараметры);
	
КонецПроцедуры


