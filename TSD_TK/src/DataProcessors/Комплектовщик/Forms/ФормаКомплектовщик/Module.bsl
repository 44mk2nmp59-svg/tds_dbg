&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	 		
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	Параметры.Свойство("ТипДокумента",ТипДокумента);
	ИнициализироватьКонстантыФормы();
	ОбновитьПодразделение();
	ОбновитьСотрудника();	

	
	
	НастроитьФормуПоЗначениямНастроек();
  	ИД_Лог = Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(),"ЧГ=");

КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
		
	ВыполняетсяЗакрытие = Ложь;
	
	
	#Если МобильноеПриложениеКлиент Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "Сканировать", "Видимость", Ложь);
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ДокументUUID) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ВыполняетсяЗакрытие Тогда
		ОбщегоНазначенияКлиентСервер.ОчиститьСотрудника();
	Иначе
		Отказ = Истина;
		//Если ЗначениеЗаполнено(ДокументUUID) Тогда
		//	ОтменитьОтборРезерваПередЗакрытием();	
		//Иначе	
			ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение",ЭтотОбъект),"Закрити комплектувальника?",РежимДиалогаВопрос.ДаНет);
		//КонецЕсли;	
КонецЕсли;
	
КонецПроцедуры



&НаКлиенте
Функция ВсегоТекВведеноУпаковщик(АртикулУпаковка = Ложь,ТолькоУпаковка = Ложь)
	
	
	Если АртикулУпаковка Тогда  
		оСтруктураУп = 	Новый Структура("Артикул,Характеристика,КоробкаНомер",ТекАртикул,ТекХарактеристика,КоробкаНомер);
	ИначеЕсли ТолькоУпаковка Тогда	
		оСтруктураУп = 	Новый Структура("КоробкаНомер",КоробкаНомер);
	Иначе     
		оСтруктураУп = 	Новый Структура("Артикул,Характеристика",ТекАртикул,ТекХарактеристика);
	КонецЕсли;
	
	
	нСтрокиУпаковщик = ТаблицаТоварыУпаковщик.НайтиСтроки(оСтруктураУп); 
	КолУпаковано = 0;
	Для Каждого стрУпаковщик Из нСтрокиУпаковщик Цикл 
		КолУпаковано = КолУпаковано +стрУпаковщик.КоличествоВведено;	
	КонецЦикла; 
	Возврат КолУпаковано;	
КонецФункции

&НаКлиенте
Функция ТоваровВУпаковке(ВыбКорокаНомер)
	нСтрокиУпаковщик =  ТаблицаТоварыУпаковщик.НайтиСтроки(Новый Структура("КоробкаНомер",ВыбКорокаНомер));
	Возврат нСтрокиУпаковщик.Количество();	
КонецФункции


&НаКлиенте
Асинх Процедура ОтменитьОтборРезерваПередЗакрытием()
    Режим = РежимДиалогаВопрос.ДаНет;
    Ответ = Ждать ВопросАсинх("Скасувати відбір резерву?", Режим, 0);
    Если Ответ = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
	ОтменитьСборкуРезерва();
	ВыполняетсяЗакрытие = Истина;
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса,ДопоплнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ВыполняетсяЗакрытие = Истина;
		Закрыть();
	КонецЕсли;
	
	
КонецПроцедуры



&НаСервере
Процедура ИнициализироватьКонстантыФормы()
	
	ИспользуетсяАсинхронныйСканер = ЗначениеНастроекВызовСервераПовтИсп.ИспользуетсяАсинхронныйСканерШтрихкодов();
	Инициализирован = НЕ ПустаяСтрока(ПараметрыСеанса.Подразделение);
    ПользовательИнициализирован = НЕ ПустаяСтрока(ПараметрыСеанса.Сотрудник); 
	
	СисИнфо = Новый СистемнаяИнформация;
   	Элементы.ИД_Устройства.Заголовок = Строка(СисИнфо.ИдентификаторКлиента);
	
КонецПроцедуры
 
&НаСервере
Процедура ОбновитьПодразделение()
	
	Если ПустаяСтрока(ПараметрыСеанса.Подразделение) Тогда
		Элементы.СообщениеИнициализации.Заголовок = "Устройство не инициализировано";
		ОбщегоНазначения.УстановитьЦветПолейОшибок(ЭтаФорма, "СообщениеИнициализации");
		Инициализирован = Ложь;
		
	Иначе

		Элементы.СообщениеИнициализации.Заголовок = ПараметрыСеанса.Подразделение;
		ОбщегоНазначения.УстановитьЦветИнформационныхНадписей(ЭтаФорма, "СообщениеИнициализации");
		Инициализирован = Истина;
		
	КонецЕсли;
	
	ОпределитьДоступностьКнопкиСканирования();
	
КонецПроцедуры

 &НаСервере
Процедура ОбновитьСотрудника()
	
	Если ПустаяСтрока(ПараметрыСеанса.Сотрудник) Тогда
		Элементы.СообщениеИнициализацииПользователя.Заголовок = "Користувач не ініціалізований";
		ОбщегоНазначения.УстановитьЦветПолейОшибок(ЭтаФорма, "СообщениеИнициализацииПользователя");
		ПользовательИнициализирован = Ложь;
	Иначе
		Элементы.СообщениеИнициализацииПользователя.Заголовок = ПараметрыСеанса.Сотрудник;
		ОбщегоНазначения.УстановитьЦветИнформационныхНадписей(ЭтаФорма, "СообщениеИнициализацииПользователя");
		ПользовательИнициализирован = Истина;
	КонецЕсли;
	   
	УстановитьДоступностьПоНастройкам();
	Если ПользовательИнициализирован И Инициализирован И ТипДокумента <> "КомплектовщикОтбор" Тогда
		ОбновитьКоличестворезервовНаСервере(КоличествоРезервов);
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаДокумент", "Видимость", Ложь);

КонецПроцедуры



&НаСервере
Процедура НастроитьФормуПоЗначениямНастроек()
	
	Если ТипДокумента = "КомплектовщикОтбор" Тогда
		ЭтаФорма.Заголовок = "Компл. відбір"; 
		ИдетПроцессСканированияТелеги = Истина;  
	КонецЕсли;
	
	
	ОпределитьДоступностьКнопкиСканирования();
	
	НастроитьЭлементыАсинхронногоСканера();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьПоНастройкам()

	ОпределитьДоступностьКнопкиСканирования();

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаПечЭтикетка","Видимость",Ложь);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "Сканировать", "Доступность", Инициализирован И ПользовательИнициализирован);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаЗадачиНаСборку,ТекМестоХранение", "Видимость", Инициализирован И ПользовательИнициализирован И ТипДокумента <> "КомплектовщикОтбор");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаЗадачиНаКомплект,ТекТележкаНомер", "Видимость", Инициализирован И ПользовательИнициализирован И ТипДокумента = "КомплектовщикОтбор");
	
КонецПроцедуры


&НаСервере
Процедура НастроитьЭлементыАсинхронногоСканера()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "АктивироватьСканер", "Видимость", 
		ИспользуетсяАсинхронныйСканер
	);
	
КонецПроцедуры

 &НаСервере
Процедура ОпределитьДоступностьКнопкиСканирования()
	
	ЕстьОборудованиеСканирования = ЗначениеЗаполнено(ЗначениеНастроекВызовСервераПовтИсп.ТипУстройстваСканирования());
	
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "Сканировать", "Доступность",
		(ЕстьОборудованиеСканирования И НЕ ИспользуетсяАсинхронныйСканер) И Инициализирован И ПользовательИнициализирован
		);   
 
	
КонецПроцедуры   











&НаКлиенте
Процедура СообщениеИнициализацииНажатие(Элемент)
	ОткрытьФорму("Обработка.Сервис.Форма.Инициализация", , ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

 &НаКлиенте
Процедура СообщениеИнициализацииПользователяНажатие(Элемент)
	ДополнительныеПараметры = Новый Структура;
	ДопПарметрыФормы = Новый Структура;
	опЗакрытие = Новый ОписаниеОповещения("ВыполнитьПослеЗакрытияВводаСотрудника",ЭтаФорма,ДополнительныеПараметры);
	ОткрытьФорму("Обработка.Сервис.Форма.ИнициализацияСотрудник",ДопПарметрыФормы, ЭтаФорма,,,,опЗакрытие, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

КонецПроцедуры

&НаКлиенте
Процедура Сканировать(Команда)
	
	ИдетПроцессСканирования = Истина;
	ОткрытьДиалогСканирования();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДиалогСканирования()
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма", ЭтаФорма);
	ДополнительныеПараметры.Вставить("ПотоковоеСканирование");
	ДополнительныеПараметры.Вставить("ЗаголовокСканирования", НСтр("ru = 'Считайте штрих-код'"));
	ДополнительныеПараметры.Вставить("ИмяОбработчикаЗакрытияСканирования", "ОбработкаЗакрытияСканирования");
	
	ПодключаемоеОборудованиеКлиент.ПолучитьШтрихкод(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеЗакрытияВводаСотрудника(Результат,ДополнительныеПараметры)Экспорт 
	
КонецПроцедуры




&НаКлиенте
Процедура АктивироватьСканер(Команда)
	
	ИнициализироватьАсинхронныйСканер();
	
КонецПроцедуры 

 &НаКлиенте
Процедура ИнициализироватьАсинхронныйСканер()
	
	ПодключаемоеОборудованиеКлиент.ИнициализироватьАсинхронныйСканер(ЭтаФорма);
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ПодключаемоеОборудованиеКлиент.ЭтоОповещениеСканераШтрихкода(ИмяСобытия) И ВводДоступен() Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Форма", ЭтаФорма);  
		
		
		
		//Иначе	
			ОбработатьПолученныйШтрихкод(Параметр, ДополнительныеПараметры);
		//КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "ИзмененоПодразделение" Тогда
		
		ОбновитьПодразделение();
		
	ИначеЕсли ИмяСобытия = "ИзмененСотрудник" Тогда
		
		ОбновитьСотрудника();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьПолученныйШтрихкод(ПолученныйШтрихкод, Параметры) Экспорт
	
	Если ПустаяСтрока(ПолученныйШтрихкод) Тогда
		Возврат;
	КонецЕсли;
	
	
	Если НЕ ПользовательИнициализирован Тогда
		
		Результат	= ИнтеграцияТК_Клиент.ПолучитьСотрудника(ПолученныйШтрихкод);

		Если Результат.Результат Тогда
			Оповестить("ИзмененСотрудник");
		Иначе
			Сообщить("Необхідна авторизація користувача");
		КонецЕсли;
		
		Возврат; 
	ИначеЕсли ИдетПроцессСканированияТелеги Тогда
		ОбработатьШтрихкодТелеги(ПолученныйШтрихкод, Параметры); 
		Возврат;
	
	ИначеЕсли ПустаяСтрока(ДокументUUID) Тогда 
		Сообщить("Резерв не вибраний");
         Возврат;	  
	ИначеЕсли ИдетПроцессСканированияПринтера Тогда
	    Возврат;
	КонецЕсли;
	//
	Если ИД_Статус <> 1 Тогда
		Возврат;
	КонецЕсли;
	
	Если КомплектовщикУпаковщик И НЕ КоробкаОткрыта Тогда
		Возврат;
	КонецЕсли;
	
		
	
	
	тквВведено = ТекКоличествоВведеноКоробка;
	//тквВведено = ?(ТекВесовой = 0,ТекКоличествоВведено,ТекКоличествоВведеноВес);	
	Если тквВведено >= ТекКоличество Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Кількість відібрано, перейдіть до наступного");	
		Возврат;
	КонецЕсли;
	
	нСтркиШтрихКод = ТаблицаШтрихКода.НайтиСтроки(Новый Структура("ШтрихКод",ПолученныйШтрихкод));
	
	Если ТекПроизводитель <> 0 И (ТекидУпаковка  = 2 Или ТекидУпаковка  = 3) Тогда //ФМ/БАТ Блоки,Ящики, 
		
		ЭтоИсключение = Ложь;
		Если нСтркиШтрихКод.Количество() > 0 И нСтркиШтрихКод[0].Артикул = ТекАртикул Тогда
			ЭтоИсключение = ПроверитьИсключение(ТекАртикул);	
		КонецЕсли;
		Если НЕ ЭтоИсключение Тогда
			ОбработатьШтрихКодФМ_БАТ(ПолученныйШтрихкод,Параметры);	
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ПоМаскеШтрихКода = Ложь;	
	Если нСтркиШтрихКод.Количество()= 0 Тогда
		СтрШтрихКод = Новый Структура;
		СтрШтрихКод.Вставить("Штрихкод",ПолученныйШтрихкод);
		//СтрШтрихКод.Вставить("ТипШтрихКода",ТипШтрихКода);
		СтрШтрихКод.Вставить("Количество",1); 
		СтрШтрихКод.Вставить("Коэффициент",1);
		СтрШтрихКод.Вставить("КодВесовогоТовара","");
		СтрШтрихКод.Вставить("ПрефиксВесовогоТовара","");   
		ОбработатьВесовойШтрихкод(СтрШтрихКод);    
		Если ПустаяСтрока(СтрШтрихКод.КодВесовогоТовара) Тогда
			Сообщить("У документі немає товару з цим штрихкодом - "+ПолученныйШтрихкод);
			Возврат;   
		Иначе  
			
			Если НЕ СтрШтрихКод.КодВесовогоТовара = ТекАртикул Тогда
				Сообщить("Ваговий артикул не належить товару - "+ТекНаименованиеТовара);
               	Возврат;
			КонецЕсли;
			
			ПоМаскеШтрихКода = Истина;
		КонецЕсли;
	КонецЕсли;
	
	
	Если НЕ ПоМаскеШтрихКода  Тогда
		СтрШтрихКод = нСтркиШтрихКод[0]; 
		Если НЕ СтрШтрихКод.Артикул = ТекАртикул Тогда
			Сообщить("Штрихкод не належить товару - "+ТекНаименованиеТовара);
			Возврат;
		КонецЕсли;  
	КонецЕсли; 

	Если ТекШтрихКодОтсканирован = Ложь Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ДекорацияСканироватьКодТовара", "Видимость", Ложь );
		ТаблицаТовары[СтрокаТовараТекущая-1].ШтрихКодОтсканирован = Истина;	 
		
	КонецЕсли;
	

	ТекШтрихКодОтсканирован = Истина;	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ТекКоличествоВведено,ТекКоличествоВведеноВес,ДобавитьКолВо", "Доступность", ТекКоличество>=25);

	 Если ТекКоэффициент = СтрШтрихКод.Коэффициент Тогда
		 новКоличество = ?(ПоМаскеШтрихКода,СтрШтрихКод.Количество,1); 
  
	 Иначе
		 новКоличество = СтрШтрихКод.Коэффициент/?(ТекКоэффициент=0,1,ТекКоэффициент); 
	 КонецЕсли;
	 
	 Если ТекВесовой = 0 И новКоличество < 1 Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не можна додати "+новКоличество + " відскануйте штрихкод "+ТекУпаковка+Символы.ПС+"Додайте кількість в ручну");	
		Возврат; 
	 КонецЕсли;
	 
	 Если ТекВесовой и ТекКоличествоВведеноКоробка + новКоличество > КомплектовщикТК_Клиент.ДопускВесовойТовар(ТекВесовой,ТекКоличество) Тогда  
		 ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не можна додати "+новКоличество+Символы.ПС+"Доступно - "+Формат(КомплектовщикТК_Клиент.ДопускВесовойТовар(ТекВесовой,ТекКоличество) -ТекКоличествоВведеноКоробка,"ЧЦ=8; ЧДЦ=3"));	
		 Возврат; 
		 
	 КонецЕсли;
	 
		 
		 
	 
	 Если ТекиспХарактеристика = 1  Тогда 
		 ВыбратьМРЦ_Асинх(ТекХарактеристика,ПолученныйШтрихкод,СтрШтрихКод.Коэффициент); 
	 Иначе	
		 Если ТекВесовой = 1 Тогда
			 ТекКоличествоВведеноВес = ТекКоличествоВведеноВес + новКоличество ;
		 Иначе
			 ТекКоличествоВведено = ТекКоличествоВведено + новКоличество;
		 КонецЕсли; 
		 
		мУпаковщик = ТаблицаТоварыУпаковщик.НайтиСтроки(Новый Структура("Артикул,КоробкаНомер",ТекАртикул,КоробкаНомер));
		Если мУпаковщик.Количество() Тогда 
			смУпаковка = мУпаковщик[0];
		Иначе
			смУпаковка = ТаблицаТоварыУпаковщик.Добавить();  
			смУпаковка.Артикул = ТекАртикул; 
			смУпаковка.КоробкаНомер = КоробкаНомер;
			
		КонецЕсли;
		
		смУпаковка.КоличествоВведено = ?(ТекВесовой=1,ТекКоличествоВведеноВес,ТекКоличествоВведено);  
		смУпаковка.Коэффициент = ТекКоэффициент;

		ТекКоличествоВведеноКоробка = ВсегоТекВведеноУпаковщик(); 
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ДекорацияПерейти", "Видимость",  ТекКоличествоВведеноКоробка = ТекКоличество ); 

	 КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьШтрихкодТелеги(ПолученныйШтрихкод, Параметры) Экспорт
	
	Если ПустаяСтрока(ПолученныйШтрихкод) Тогда
		Возврат;
	КонецЕсли;

	Результат = ПроверитьТележку(ПолученныйШтрихкод);
	Если ПустаяСтрока(Результат.ТекстОшибки) И Результат.ТележкаРабочий Тогда
		
		РезультатРезервыКомплект = ПолучитьРезервТележки(ПолученныйШтрихкод);		
		
		Если  РезультатРезервыКомплект.Результат = Ложь Тогда
			Если Не ПустаяСтрока(РезультатРезервыКомплект.ОписаниеОшибки) Тогда
				Сообщить(РезультатРезервыКомплект.ОписаниеОшибки);
			Иначе
				Сообщить("Помилка отримання резервів!");	  
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
		ОбработатьСтрукуруРезерваНаСервере(РезультатРезервыКомплект);
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаЗадачиНаКомплект", "Видимость",  Ложь );
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаСтрокаТовара", "Видимость",  Истина );
	Иначе
		Если Не ПустаяСтрока(Результат.ТекстОшибки) Тогда
			Сообщить(Результат.ТекстОшибки);
		Иначе
			Сообщить("Не удалось отсканировать тележку!");
		КонецЕсли; 
	КонецЕсли;
		
КонецПроцедуры


#Область Ввод_МРЦ
&НаКлиенте
Процедура ОбработатьШтрихКодФМ_БАТ(ПолученныйШтрихКод,Параметры)
	
	ЭтоШККороба 	= СтрДлина(ПолученныйШтрихкод) > 60 И Лев(ПолученныйШтрихкод, 3) = "010";
	ЭтоШКБлока 	= Не ЭтоШККороба И ((СтрДлина(ПолученныйШтрихкод) > 16 И (Лев(ПолученныйШтрихкод, 3) = "010" ИЛИ Лев(ПолученныйШтрихкод, 3) = "343")));	//тут
	
	Если ЭтоШККороба = Ложь И ЭтоШКБлока = Ложь Тогда
		Сообщить("Відскануйте штрих-код виробника"); 
		Возврат;
	КонецЕсли;
	
	
	Если Лев(ПолученныйШтрихкод, 3) = "010" Тогда
		текШтрихКод = Сред(ПолученныйШтрихкод, 4, 13);
	Иначе
		текШтрихКод = Сред(ПолученныйШтрихкод, 4, 8);
		Пока Лев(текШтрихКод, 1) = "0" Цикл
			текШтрихКод = Прав(текШтрихКод,СтрДлина(текШтрихКод) - 1);
		КонецЦикла;
	КонецЕсли;	
	
	Если ТекПроизводитель = 1 Или ТекПроизводитель = 2 Тогда  // 1-PMU, 2-BAT 
		нмШтрихПроизв =  ТаблицаШтрихКодаПроизводителей.НайтиСтроки(Новый Структура("ДанныеШтрихКода",ПолученныйШтрихКод));
		Если нмШтрихПроизв.Количество()>0 Тогда
			Сообщить("штрих-код виробника відскановано раніше");
			Возврат;
		КонецЕсли;
		
		//ПроверитьШтрихНаСервере
		Если ПроверитьШтрихКодПоставщикаНаСервере(ПолученныйШтрихКод) Тогда
			Сообщить("штрих-код виробника відскановано раніше");
			Возврат;
		КонецЕсли;	
	
	КонецЕсли;
	
	
	
	знПолученныйШтрихкод = текШтрихКод;
	
	нСтркиШтрихКод = ТаблицаШтрихКода.НайтиСтроки(Новый Структура("ШтрихКод",знПолученныйШтрихкод));
	Если нСтркиШтрихКод.Количество()= 0 Тогда
		Сообщить("У документі немає товару з цим штрихкодом - "+ПолученныйШтрихкод);
		Возврат;
	КонецЕсли;   
	
	СтрШтрихКод = нСтркиШтрихКод[0]; 
	Если НЕ СтрШтрихКод.Артикул = ТекАртикул Тогда
		Сообщить("Штрихкод не належить товару - "+ТекНаименованиеТовара);
		Возврат;
	КонецЕсли;  
	ШтрихКодКоэффициент = СтрШтрихКод.Коэффициент;
	
	КодМРЦ = "";	
	Если ТекПроизводитель = 1 Тогда //PMU
		Если ЭтоШКБлока Тогда
			КодМРЦ = Прав(ПолученныйШтрихКод, 11);
		КонецЕсли;
	ИначеЕсли ТекПроизводитель = 2 Тогда  //BAT
		Если ЭтоШКБлока Тогда 
			КодМРЦ = Прав(ПолученныйШтрихКод, 8);	
		ИначеЕсли ЭтоШККороба Тогда 
			ПозицияМРЦ = СтрНайти(ПолученныйШтрихКод, "240", НаправлениеПоиска.СНачала, 14) + 3; 
			Если ПозицияМРЦ > 3 Тогда 
				КодМРЦ = Сред(ПолученныйШтрихКод, ПозицияМРЦ, 8);
			КонецЕсли;  
		КонецЕсли;	
	ИначеЕсли ТекПроизводитель = 3 Тогда  //JTI
		Если ЭтоШКБлока Тогда 
			КодМРЦ = Прав(ПолученныйШтрихКод, 8);	
		КонецЕсли;
	КонецЕсли;
	
	РазмерМРЦ = 0;	
	Если НЕ ПустаяСтрока(КодМРЦ) Тогда 
		РазмерМРЦ = ПолучитьМРЦ_ПоКоду(ТекАртикул,КодМРЦ);
	КонецЕсли;
	
	Если РазмерМРЦ = 0 Тогда // нужно выбрать мрц
		ВыбратьМРЦ_Асинх(РазмерМРЦ,ПолученныйШтрихКод,ШтрихКодКоэффициент);
	Иначе
		ОбработатьВводМРЦ(РазмерМРЦ,ПолученныйШтрихКод,ШтрихКодКоэффициент);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВводМРЦ(РазмерМРЦ,ПолученныйШтрихКод,ШтрихКодКоэффициент,РучнойВвод = Ложь)
	
	Если РазмерМРЦ = 0 Тогда 
		 Сообщить("МРЦ не вибрано!"); 
		Возврат;
	КонецЕсли;

	Если РучнойВвод Тогда
		
		мСтрокиТоварМРЦ = ТаблицаШтрихКодаПроизводителей.НайтиСтроки(Новый Структура("Артикул",ТекАртикул));
		Если мСтрокиТоварМРЦ.Количество() = 0 Тогда
			НоваяСтрокаШКП = ТаблицаШтрихКодаПроизводителей.Добавить();
		ИначеЕсли мСтрокиТоварМРЦ.Количество() = 1 Тогда
			НоваяСтрокаШКП = мСтрокиТоварМРЦ[0];
		Иначе
			для Каждого стрТоварМРЦ Из мСтрокиТоварМРЦ Цикл 
				ТаблицаШтрихКодаПроизводителей.Удалить(стрТоварМРЦ);
			КонецЦикла;
			НоваяСтрокаШКП = ТаблицаШтрихКодаПроизводителей.Добавить();
		КонецЕсли;
			
		ТекХарактеристика = РазмерМРЦ;
		НоваяСтрокаШКП.идПроизводитель = ТекПроизводитель;
		НоваяСтрокаШКП.ДанныеШтрихКода = ПолученныйШтрихКод;
		НоваяСтрокаШКП.Артикул = ТекАртикул;
		НоваяСтрокаШКП.Характеристика = РазмерМРЦ;
		НоваяСтрокаШКП.КоличествоВведено = ТекКоличествоВведено;; 

		
		мУпаковщик = ТаблицаТоварыУпаковщик.НайтиСтроки(Новый Структура("Артикул,Характеристика,КоробкаНомер",ТекАртикул,ТекХарактеристика,КоробкаНомер));
		Если мУпаковщик.Количество() Тогда 
			смУпаковка = мУпаковщик[0];
		Иначе
			смУпаковка = ТаблицаТоварыУпаковщик.Добавить();  
			смУпаковка.Артикул = ТекАртикул;  
			смУпаковка.Характеристика = ТекХарактеристика; 

			смУпаковка.КоробкаНомер = КоробкаНомер;
		КонецЕсли;
		
		смУпаковка.КоличествоВведено = ТекКоличествоВведено;  
		смУпаковка.Коэффициент = ТекКоэффициент;
		
		ТекКоличествоВведеноКоробка = ВсегоТекВведеноУпаковщик(); 	
		

		
		
	Иначе	
		Если ТекКоэффициент = ШтрихКодКоэффициент Тогда
			ДобавитьНовТекКоличествоВведено =  1;   
		Иначе
			ДобавитьНовТекКоличествоВведено = ШтрихКодКоэффициент/?(ТекКоэффициент=0,1,ТекКоэффициент);  
		КонецЕсли;
		
		Если ДобавитьНовТекКоличествоВведено < 1 Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не можна додати "+ДобавитьНовТекКоличествоВведено + " відскануйте штрихкод "+ТекУпаковка);	
			Возврат; 
		КонецЕсли;
		
		
		НовТекКоличествоВведено = ТекКоличествоВведено + ДобавитьНовТекКоличествоВведено; 
		
		Если НовТекКоличествоВведено > КомплектовщикТК_Клиент.ДопускВесовойТовар(ТекВесовой,ТекКоличество) Тогда
			Сообщить("Перевищено кількість відбору!"); 
			Возврат;    
		КонецЕсли;
		
		ТекКоличествоВведено = НовТекКоличествоВведено; 
		
		ТекХарактеристика = РазмерМРЦ;
		НоваяСтрокаШКП = ТаблицаШтрихКодаПроизводителей.Добавить(); 
		НоваяСтрокаШКП.идПроизводитель = ТекПроизводитель;
		НоваяСтрокаШКП.ДанныеШтрихКода = ПолученныйШтрихКод;
		НоваяСтрокаШКП.Артикул = ТекАртикул;
		НоваяСтрокаШКП.Характеристика = РазмерМРЦ;
		НоваяСтрокаШКП.КоличествоВведено = ДобавитьНовТекКоличествоВведено; 
		
		мУпаковщик = ТаблицаТоварыУпаковщик.НайтиСтроки(Новый Структура("Артикул,Характеристика,КоробкаНомер",ТекАртикул,ТекХарактеристика,КоробкаНомер));
		Если мУпаковщик.Количество() Тогда 
			смУпаковка = мУпаковщик[0];
		Иначе
			смУпаковка = ТаблицаТоварыУпаковщик.Добавить();  
			смУпаковка.Артикул = ТекАртикул; 
			смУпаковка.Характеристика = ТекХарактеристика;
			смУпаковка.КоробкаНомер = КоробкаНомер;
		КонецЕсли;
		
		смУпаковка.КоличествоВведено = НовТекКоличествоВведено;  
		смУпаковка.Коэффициент = ТекКоэффициент;
		
		ТекКоличествоВведеноКоробка = ВсегоТекВведеноУпаковщик(); 	
		
		
	КонецЕсли;	
	

	Если ТекКоличествоВведено  >= ТекКоличество  Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ДекорацияПерейти", "Видимость", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ДекорацияСканироватьКодТовара", "Видимость", Ложь);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ДекорацияПерейти", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ДекорацияСканироватьКодТовара", "Видимость", Истина);
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыбратьМРЦ_Асинх(РазмерМРЦ,ПолученныйШтрихКод,ШтрихКодКоэффициент,РучнойВвод=Ложь) 
	
	
	 СписокОстаткиМРЦ = ПолучитьМРЦ_НаОстатке(ТекАртикул,СкладUUID);
	 Если СписокОстаткиМРЦ.Количество() = 0 Тогда
		 Сообщить("Немає залишку"); 
		Возврат  
	 КонецЕсли;
	 
	Обещание = СписокОстаткиМРЦ.ВыбратьЭлементАсинх("МРЦ");
	Рез = Ждать Обещание;
	Если Рез = Неопределено Тогда
		РазмерМРЦ = 0;
	Иначе
		РазмерМРЦ = Рез.Значение;
	КонецЕсли;  
	Если ТекХарактеристика <> РазмерМРЦ Тогда 
		 Сообщить("МРЦ резерв - "+ТекХарактеристика+Символы.ПС+"МРЦ вибрано - "+РазмерМРЦ); 
		Возврат;  
	КонецЕсли;
	
	
	ОбработатьВводМРЦ(РазмерМРЦ,ПолученныйШтрихКод,ШтрихКодКоэффициент,РучнойВвод);
	
КонецПроцедуры

#КонецОбласти  

 &НаСервереБезКонтекста
Процедура ОбработатьВесовойШтрихкод(структураШтриход)
	РегистрыСведений.Штрихкоды.ПреобразоватьВесовойШтрихкод(структураШтриход);
КонецПроцедуры
 

 &НаСервереБезКонтекста
Функция ПроверитьШтрихКодПоставщикаНаСервере(ШК)    
	
	текстЗапроса = "/Complect/"+ПараметрыСеанса.UUID+"/chkp?uuidcom="+ПараметрыСеанса.Сотрудник_ID+"&chk="+ШК;
	РезОтвет = КомплектовщикТК.ПодготовитьGETЗапрос(текстЗапроса);
	Если РезОтвет.Результат Тогда
		ШтрихКодОтсканирован = ?(РезОтвет.Ответ.ШКРез=1,Истина,Ложь);	
	Иначе  
		ШтрихКодОтсканирован = Истина;
	КонецЕсли;
	
	Возврат ШтрихКодОтсканирован	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьМРЦ_ПоКоду(Знач АртикулТовара,Знач КодМРЦ)    
	
	текстЗапроса = "/Complect/"+ПараметрыСеанса.UUID+"/mrc?uuidcom="+ПараметрыСеанса.Сотрудник_ID+"&art="+АртикулТовара+"&kodmrc="+КодМРЦ;
	РезОтвет = КомплектовщикТК.ПодготовитьGETЗапрос(текстЗапроса);
	Если РезОтвет.Результат Тогда
		РазмерМРЦ = РезОтвет.Ответ.РазмерМРЦ;	
	Иначе  
		РазмерМРЦ = 0;
	КонецЕсли;
	
	Возврат РазмерМРЦ	
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьИсключение(АртикулТовара)    
	
	
	текстЗапроса = "/Complect/"+ПараметрыСеанса.UUID+"/isk?uuidcom="+ПараметрыСеанса.Сотрудник_ID+"&art="+АртикулТовара;
	РезОтвет = КомплектовщикТК.ПодготовитьGETЗапрос(текстЗапроса);
	Если РезОтвет.Результат Тогда
		РезОтвет = РезОтвет.Ответ.ИсключениеПоставщика;	
	Иначе  
		РезОтвет = 0;
	КонецЕсли;
	
	Возврат Булево(РезОтвет);  

КонецФункции

&НаСервереБезКонтекста
Функция ОтправитьНапечатьЧекрезерв(РезервUUID)    
	
	текстЗапроса = "/Complect/"+ПараметрыСеанса.UUID+"/chekrez?uuidcom="+ПараметрыСеанса.Сотрудник_ID+"&UUIDrez="+РезервUUID;
	РезОтвет = КомплектовщикТК.ПодготовитьGETЗапрос(текстЗапроса);
	Если РезОтвет.Результат Тогда
		РезОтвет = 1;	
	Иначе  
		РезОтвет = 0;
	КонецЕсли;
	
	Возврат Булево(РезОтвет);  

КонецФункции


&НаСервереБезКонтекста
Функция ПолучитьМРЦ_НаОстатке(Знач АртикулТовара,Знач СкладUUID)
	
	текстЗапроса = "/Complect/"+ПараметрыСеанса.UUID+"/mrcost?uuidcom="+ПараметрыСеанса.Сотрудник_ID+"&art="+АртикулТовара+"&skladuuid="+СкладUUID;
	РезОтвет = КомплектовщикТК.ПодготовитьGETЗапрос(текстЗапроса);
	СписокОстаткиМРЦ = Новый СписокЗначений;
	Если РезОтвет.Результат Тогда
		
