&НаКлиенте
Процедура ОбработатьПереходВперед() 
	
	МестоХраненияОтсканировано = Ложь;
	текСтрокатовары = ТаблицаТовары.НайтиПоИдентификатору(ТекИдентификаторСтроки);	
	текСтрокатовары.КоличествоВведено = ВсегоТекВведеноУпаковщик();//?(ТекВесовой = 0,ТекКоличествоВведено,ТекКоличествоВведеноВес);		
	текСтрокатовары.Отобрано = текСтрокатовары.Количество = текСтрокатовары.КоличествоВведено;
	текСтрокатовары.ШтрихКодОтсканирован = ТекШтрихКодОтсканирован;
	
	
	
	СтрокаТовараТекущая = СтрокаТовараТекущая +1;
	
	Если СтрокаТовараТекущая <= СтрокаТовараВсего Тогда
		новСтрокатовары = ТаблицаТовары[СтрокаТовараТекущая-1];
		ОбработатьПереходКнопкиВпередНазад(новСтрокатовары);
		
	Иначе  
		СтрокаТовараТекущая = СтрокаТовараТекущая - 1;
		ТаблицаРасхождений.Очистить();	
		мНеОтобранныеСтроки =  ТаблицаТовары.НайтиСтроки(Новый Структура("Отобрано",Ложь));
		Если мНеОтобранныеСтроки.Количество() >  0 Тогда
			Для Каждого стрТоварыОт Из мНеОтобранныеСтроки Цикл 
				стрТаблицаРасхождений = ТаблицаРасхождений.Добавить(); 
				ЗаполнитьЗначенияСвойств(стрТаблицаРасхождений,стрТоварыОт,"НаименованиеТовара,Упаковка,Артикул,Коэффициент,Количество,КоличествоВведено,Весовой,КоличествоБаз");
				стрТаблицаРасхождений.ИдентификаторСтрокиТоваров = стрТоварыОт.ПолучитьИдентификатор();
			КонецЦикла;
			//	Иначе
			
		КонецЕсли;  
		
		Если КоробкаОткрыта И ВсегоТекВведеноУпаковщик(Ложь,Истина) Тогда
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаКнопкаЗавершитьЗакрытьКоробку", "Видимость", Истина);	
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаКнопкаЗак", "Видимость", Ложь);	
			
		Иначе
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаКнопкаЗавершитьЗакрытьКоробку", "Видимость", Ложь);	
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаКнопкаЗак", "Видимость", Истина);	
			
		КонецЕсли;
		
		Элементы.ГруппаШапкаДокумента.Показать();
		
		ПерейтиНаЗапросФормированияДокументов();
		
	КонецЕсли;                      
	
КонецПроцедуры
 
