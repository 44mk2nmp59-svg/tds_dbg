&НаСервере
Процедура ОбработатьСтрукуруРезерваНаСервере(РезОтвет)
	
    ОчиситьПеременныеФормы();
	
 	Если РезОтвет.Результат Тогда
	ИД_Статус = 0;		
	СтруктураДокумента = РезОтвет.Ответ;
	
	Если СтруктураДокумента.Товары.Количество() = 0 Тогда
		 Сообщить("Нет товаров для сборки");
		 Возврат;
	КонецЕсли;
	
	СтруктураДокумента.Свойство("КомплектовщикУпаковщик",КомплектовщикУпаковщик);	
	СтруктураДокумента.Свойство("ИспользоватьШоллер",ИспользоватьШоллер);	
	СтруктураДокумента.Свойство("ИспользоватьТЕ",ИспользоватьТЕ);	

	НачалоКонтроля = ТекущаяДатаСеанса();
	ДокументUUID = СтруктураДокумента.ДокументUUID;	
	
	СкладUUID = СтруктураДокумента.СкладUUID;
	Элементы.ДекорацияНомерРезерва.Заголовок =  "Резерв "+СтруктураДокумента.НомерРезерва;
	Элементы.ДекорацияДатаЗаказа.Заголовок =  "Дата заказа "+СтруктураДокумента.ДатаЗаказа;
	Элементы.ДекорацияНомерТочки.Заголовок =  "Адреса "+СтруктураДокумента.ТочкаДоставки;
	Элементы.ДекорацияНомерМаршрута.Заголовок = "Маршрут "+ СтруктураДокумента.Порядок;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ГруппаШапкаДокумента,ГруппаСтрокаТовара", "Видимость", Истина);	
	Вес = СтруктураДокумента.Вес;	
    КоличествоБаз = СтруктураДокумента.КоличествоБаз;	
	
	
	
	Для Каждого стТовар Из СтруктураДокумента.Товары Цикл 
		нстрТовар = ТаблицаТовары.Добавить();
		нстрТовар.Артикул = стТовар.Артикул;
		нстрТовар.ТоварнаяМарка = стТовар.ТоварнаяМарка; 
		нстрТовар.НаименованиеТовара = стТовар.Номенклатура; 
		нстрТовар.Упаковка           = стТовар.ЕдиницаИзмерения;
		нстрТовар.Характеристика    = стТовар.ЗначениеМРЦ;
		нстрТовар.испХарактеристика    = стТовар.испХарактеристика;

		нстрТовар.Коэффициент      = стТовар.Коэффициент; 
		нстрТовар.Количество      = стТовар.Количество; 
		нстрТовар.КоличествоБаз      = стТовар.КоличествоБаз;               
		нстрТовар.Производитель      = стТовар.Производитель; //1-ФМ, 2-БАТ, 0-Все остальные
        нстрТовар.идУпаковка      = стТовар.идУпаковка;  //1 - баз ед.изм (шт, пачки), 2 - Упакавка (блоки) , 3 - ящики, 0 - непонятные
		нстрТовар.ЗаказИД       = стТовар.ЗаказИД;
        нстрТовар.СкладИД       = стТовар.СкладИД;
		нстрТовар.Весовой       = стТовар.Весовой;
		нстрТовар.МестоХранение = стТовар.НомерЯчейки;
	КонецЦикла;
	
	Для Каждого стШтрихКод Из СтруктураДокумента.ШтрихКода Цикл  
		
		нстрШтрихКод = ТаблицаШтрихКода.Добавить();
		нстрШтрихКод.ШтрихКод = СокрЛП(стШтрихКод.ШтрихКод);  
		нстрШтрихКод.Артикул = стШтрихКод.Артикул;
		нстрШтрихКод.Упаковка = стШтрихКод.Упаковка;
		нстрШтрихКод.Коэффициент = стШтрихКод.Коэффициент;
		
	КонецЦикла; 
	
	Если СтруктураДокумента.Свойство("ТоварыТележки") Тогда
		
		Для Каждого стТоварыТележки Из СтруктураДокумента.ТоварыТележки Цикл  
			
			нстрШтрихКод = ТаблицаТоварыТележки.Добавить();
			нстрШтрихКод.Артикул = стТоварыТележки.Артикул;
			нстрШтрихКод.Количество = стТоварыТележки.Количество;
			нстрШтрихКод.НомерТележки = стТоварыТележки.НомерТележки;
			
		КонецЦикла;
		
	КонецЕсли;
	СтрокаТовараВсего = ТаблицаТовары.Количество();
	СтрокаТовараТекущая = 1;
	стрТовары = ТаблицаТовары[0];
	
	ТекАртикул = стрТовары.Артикул;
	ТекВесовой = стрТовары.Весовой;
	ТекИдентификаторСтроки = стрТовары.ПолучитьИдентификатор();	
	ТекКоличество = стрТовары.Количество;	
	ТекКоличествоВведено = стрТовары.КоличествоВведено;  
	ТекКоличествоВведеноВес = стрТовары.КоличествоВведено; 

	ТекКоэффициент = стрТовары.Коэффициент; 
    ТекМестоХранение = стрТовары.МестоХранение;
	ТекМестоХранениеИД = стрТовары.МестоХранениеИД;	
	ТекТоварнаяМарка = стрТовары.ТоварнаяМарка;
	ТекНаименованиеТовара = стрТовары.НаименованиеТовара;
	ТекУпаковка	          = стрТовары.Упаковка; 
	ТекХарактеристика     = стрТовары.Характеристика; 
	ТекиспХарактеристика     = стрТовары.испХарактеристика;

	ТекПроизводитель      = стрТовары.Производитель; //1-ФМ, 2-БАТ, 0-Все остальные
	ТекидУпаковка         = стрТовары.идУпаковка;    //1 - баз ед.изм (шт, пачки), 2 - Упакавка (блоки) , 3 - ящики, 0 - непонятные 
	РучнойВводБезШтрикода = Ложь;
	Если ТаблицаШтрихКода.НайтиСтроки(Новый Структура("Артикул",ТекАртикул)).Количество() = 0 и НЕ (ТекПроизводитель = 1 ИЛИ ТекПроизводитель = 2) Тогда
		ТекШтрихКодОтсканирован = Истина;  
		РучнойВводБезШтрикода = Истина;//нет штрихкодов ввод вручную
	Иначе
		ТекШтрихКодОтсканирован = стрТовары.ШтрихКодОтсканирован;   
	КонецЕсли;
	
	мстрокиТележки =  ТаблицаТоварыТележки.НайтиСтроки(Новый Структура("Артикул",ТекАртикул)); 
	
	для Каждого стрТ Из мстрокиТележки Цикл 
		ТекТележкаНомер = ТекТележкаНомер + стрТ.НомерТележки +"-" +Строка(стрТ.Количество) +";";
	КонецЦикла;

	
	
   	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ТекКоличество,ТекКоличествоВведеноКоробка", "Формат", ?(ТекВесовой = 1,"ЧЦ=15; ЧДЦ=3","ЧЦ=15; ЧДЦ=0"));	
   	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ТекКоличествоВведено", "Видимость", ТекВесовой = 0 );
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ТекКоличествоВведеноВес", "Видимость", ТекВесовой = 1 ); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаСтрокаМРЦ", "Видимость", ТекиспХарактеристика = 1 );
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаЗакрытьКоробку", "Видимость", КомплектовщикУпаковщик );

	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаДокумент,ГруппаЗадачиНаСборку,ДекорацияПерейти", "Видимость", Ложь);
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаТовары,ГруппаКнопки,ДекорацияСканироватьКодТовара", "Видимость", Истина);
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ТекКоличествоВведено,ТекКоличествоВведеноВес,ДобавитьКолВо", "Доступность", ТекКоличество>=25);
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ДекорацияСканироватьКодТовара", "Видимость", ТекШтрихКодОтсканирован = Ложь );
	ИдетПроцессСканированияТелеги = Ложь; 
	ИдетПроцессСканированияПринтера = Ложь;
	Иначе
		Если Не ПустаяСтрока(РезОтвет.ОписаниеОшибки) Тогда
			Сообщить(РезОтвет.ОписаниеОшибки);
		Иначе
			Сообщить("Помилка отримання резервів!");	  
		КонецЕсли;
		
	КонецЕсли;
	


