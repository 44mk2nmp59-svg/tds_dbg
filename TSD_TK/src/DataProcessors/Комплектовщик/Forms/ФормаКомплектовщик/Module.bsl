&НаКлиенте
Процедура ДобавитьКолВо(Команда)

	колВоДобавить = ТекКоличество - ТекКоличествоВведеноКоробка;	
	Если ТекВесовой Тогда 
		ТекКоличествоВведеноВес = ТекКоличествоВведеноВес + колВоДобавить; 
	Иначе    
		ТекКоличествоВведено = ТекКоличествоВведено + колВоДобавить;
	КонецЕсли;
    ДобавитьКолВоУпаковщик();

КонецПроцедуры    

&НаКлиенте
Процедура ДобавитьКолВоУпаковщик()
	
	ТекКолВВод =  ?(ТекВесовой=1,ТекКоличествоВведеноВес,ТекКоличествоВведено);
	ВсегоВведено = ТекКолВВод + ВсегоТекВведеноУпаковщик()-ВсегоТекВведеноУпаковщик(Истина);
	
	Если ВсегоВведено>КомплектовщикТК_Клиент.ДопускВесовойТовар(ТекВесовой,ТекКоличество) Тогда
		Сообщить("перевищення! - "+Формат(ВсегоВведено-КомплектовщикТК_Клиент.ДопускВесовойТовар(ТекВесовой,ТекКоличество),"ЧЦ=15; ЧДЦ=3"));
		Возврат;
	КонецЕсли;
	
	
	Если ТекиспХарактеристика = 1 Тогда
		
		ВыбратьМРЦ_Асинх(ТекХарактеристика,ТекАртикул,ТекКоэффициент,Истина);  
		Возврат;
	КонецЕсли;
	
	отборКоробка = Новый Структура("Артикул,Характеристика,КоробкаНомер",ТекАртикул,ТекХарактеристика,КоробкаНомер);
	
	мУпаковщик = ТаблицаТоварыУпаковщик.НайтиСтроки(отборКоробка);
	Если мУпаковщик.Количество() Тогда 
		смУпаковка = мУпаковщик[0];
	Иначе
		смУпаковка = ТаблицаТоварыУпаковщик.Добавить();  
		смУпаковка.Артикул = ТекАртикул;  
		смУпаковка.Характеристика = ТекХарактеристика; 
		смУпаковка.КоробкаНомер = КоробкаНомер;
	КонецЕсли;
	
	смУпаковка.КоличествоВведено = ТекКолВВод;  
	смУпаковка.Коэффициент = ТекКоэффициент;

	ТекКоличествоВведеноКоробка = ВсегоТекВведеноУпаковщик();
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ДекорацияПерейти", "Видимость",  ТекКоличествоВведеноКоробка = ТекКоличество ); 

КонецПроцедуры


