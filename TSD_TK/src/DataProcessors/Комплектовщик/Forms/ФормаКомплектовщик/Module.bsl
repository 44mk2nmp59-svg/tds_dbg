&НаСервере
Процедура ОтменитьСборкуРезерва()

	Если ТипДокумента = "КомплектовщикОтбор" Тогда
		ПарамОтмена = "rezervotmenavol";
	Иначе
		ПарамОтмена = "rezervotmena";
	КонецЕсли;
	
	текстЗапроса = "/Complect/"+ПараметрыСеанса.UUID+"/"+ПарамОтмена+"?uuiddoc="+ДокументUUID+"&uuidcom="+ПараметрыСеанса.Сотрудник_ID;
	Если НЕ ПустаяСтрока(ДокументПеремещениеUUID) Тогда  
		  текстЗапроса = текстЗапроса+"&uuiddocp="+ДокументПеремещениеUUID;
	КонецЕсли;
	
	РезОтвет = КомплектовщикТК.ПодготовитьGETЗапрос(текстЗапроса);
	Если РезОтвет.Результат Тогда
		ТаблицаМестаХранений.Очистить();
		ТаблицаРасхождений.Очистить();
		ТаблицаТовары.Очистить();
		ТаблицаШтрихКода.Очистить();
		ДокументUUID ="";
		ДокументПеремещениеUUID = "";
		КоробкаНомер = 0;  
		КоробкаОткрыта = Ложь;
		ИспользоватьТЕ = Ложь;
		ТаблицаТУ.Очистить();
	

		КоличествоРезервов = РезОтвет.Ответ.ОчередьСборки; 	
		Если ТипДокумента = "КомплектовщикОтбор" Тогда
			ИдетПроцессСканированияТелеги = Истина; 
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаТовары,ГруппаДокумент,ГруппаУпаковкаКоробка,ГруппаКнопкиОтменаОК,ГруппаКнопки,ДекорацияПерейти", "Видимость", Ложь);	
  			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаЗадачиНаКомплект", "Видимость", Истина);	
		Иначе
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаЗадачиНаСборку", "Видимость", Истина);	
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаТовары,ГруппаДокумент,ГруппаУпаковкаКоробка,ГруппаКнопкиОтменаОК,ГруппаКнопки", "Видимость", Ложь);	
		КонецЕсли;
	Иначе
		Если Не ПустаяСтрока(РезОтвет.ОписаниеОшибки) Тогда
			Сообщить(РезОтвет.ОписаниеОшибки);
		Иначе
			Сообщить("Помилка скасування резерву!");	  
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Функция ВыгрузитьРезультатыСканирования()
	
	МассивТовары = Новый Массив;	
	ФиксСтруктура ="Артикул,Характеристика,Коэффициент,КоличествоВведено,ЗаказИД,СкладИД"; 
	Для Каждого стрТовар Из ТаблицаТовары Цикл 
		Если стрТовар.КоличествоВведено = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтруктураСтрока = Новый Структура(ФиксСтруктура);    
		ЗаполнитьЗначенияСвойств(СтруктураСтрока,стрТовар);	
		МассивТовары.Добавить(СтруктураСтрока);	
		
	КонецЦикла;  
	                
	МассивТоварыМРЦ = Новый Массив; 
	ФиксСтруктура = "идПроизводитель,ДанныеШтрихКода,Артикул,Характеристика,КоличествоВведено";
	Для Каждого стрТовар Из ТаблицаШтрихКодаПроизводителей Цикл 
		нстрокаСтруктура = Новый Структура(ФиксСтруктура);	
		ЗаполнитьЗначенияСвойств(нстрокаСтруктура,стрТовар);
		МассивТоварыМРЦ.Добавить(нстрокаСтруктура);
	КонецЦикла;
	
	
	Если МассивТовары.Количество()  = 0 Тогда
		Сообщить("Немає товарів для вивантаження");
		Возврат Новый Структура("Результат",Ложь);
	КонецЕсли;
	
	МассивТара = Новый Массив;
	ФиксСтруктура = "Артикул,Количество";
	Для Каждого стТара Из ТаблицаТара Цикл 
		нстрокаСтруктура = Новый Структура(ФиксСтруктура);	
		ЗаполнитьЗначенияСвойств(нстрокаСтруктура,стТара);
		МассивТара.Добавить(нстрокаСтруктура);
	КонецЦикла;
	
	
	СтруктураДокумента = Новый Структура;
	СтруктураДокумента.Вставить("UUID_Документ",ДокументUUID); 
	СтруктураДокумента.Вставить("UUID_Сотрудник",ПараметрыСеанса.Сотрудник_ID);
	СтруктураДокумента.Вставить("НачалоКонтроля",НачалоКонтроля);
	СтруктураДокумента.Вставить("Товары",МассивТовары);
	СтруктураДокумента.Вставить("МассивТоварыМРЦ",МассивТоварыМРЦ); 
	СтруктураДокумента.Вставить("МассивТара",МассивТара);
	СтруктураДокумента.Вставить("ИспользоватьШоллер",ИспользоватьШоллер);

	СтруктураДокумента.Вставить("ПечатьТСД",?(ЗначениеНастроекВызовСервераПовтИсп.ИспользуетсяПечатьНаПринтер(),1,0));
	Если Не ПустаяСтрока(ДокументПеремещениеUUID) Тогда
		СтруктураДокумента.Вставить("UUID_Перемещение",ДокументПеремещениеUUID);
	КонецЕсли;

	Если ТипДокумента ="КомплектовщикОтбор" Тогда
		парамЗапрос = "DocFinihvol";	
	Иначе
		парамЗапрос = "DocFinih";	
	КонецЕсли;

	
   	ТекстЗапроса = "/Complect/"+ПараметрыСеанса.UUID+"/"+парамЗапрос;
	РезОтвет = КомплектовщикТК.ОтправитьНаСервер(СтруктураДокумента,ТекстЗапроса);
	Если РезОтвет.Результат Тогда 
		КоличествоРезервов = РезОтвет.Ответ.ОчередьСборки; 	
		
		Если ТипДокумента = "КомплектовщикОтбор" Тогда     
			ИдетПроцессСканированияТелеги = Истина;
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаЗадачиНаКомплект", "Видимость", Истина);			
		Иначе
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаЗадачиНаСборку", "Видимость", Истина);	
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаДокумент,ГруппаРасхождения,ГруппаКнопкиОтменаОК", "Видимость", Ложь);	
			   
		ТаблицаМестаХранений.Очистить();
		ТаблицаРасхождений.Очистить();
		ТаблицаТовары.Очистить();  
		ТаблицаТоварыТележки.Очистить(); 
		ТаблицаТоварыУпаковщик.Очистить();
		ТаблицаШтрихКода.Очистить();
		ТаблицаШтрихКодаПроизводителей.Очистить();   
		ТаблицаТара.Очистить();
		ДокументUUID = "";
		ДокументПеремещениеUUID = "";  
		КоробкаОткрыта = Ложь;  
		ИспользоватьШоллер = Ложь; 
		ИспользоватьТЕ = Ложь;
		ТаблицаТУ.Очистить();
		

	Иначе
		Если Не ПустаяСтрока(РезОтвет.ОписаниеОшибки) Тогда
			Сообщить(РезОтвет.ОписаниеОшибки);
		Иначе
			Сообщить("Помилка вивантаження документа!");	  
		КонецЕсли;
		
	КонецЕсли;
	Возврат РезОтвет;
	
КонецФункции

&НаСервере
Функция СоздатьРаспечататьКоробку(ИД_Принтер,КолВоСтик = 1)
	
	МассивТовары = Новый Массив;	
	ФиксСтруктура ="Артикул,Характеристика,Коэффициент,КоличествоВведено"; 

    нМассивКоробка = ТаблицаТоварыУпаковщик.НайтиСтроки(Новый Структура("КоробкаНомер",КоробкаНомер));
	
	Для Каждого стрКоробка Из нМассивКоробка Цикл 
		Если стрКоробка.КоличествоВведено = 0 Тогда Продолжить; КонецЕсли;
		нстрокаСтруктура = Новый Структура(ФиксСтруктура);	
		ЗаполнитьЗначенияСвойств(нстрокаСтруктура,стрКоробка);	
		МассивТовары.Добавить(нстрокаСтруктура);
	КонецЦикла;
	
   	
	Если МассивТовары.Количество()  = 0 Тогда
		Сообщить("Немає товарів для друку коробки");
		Возврат Ложь;
	КонецЕсли;
	
	СтруктураДокумента = Новый Структура;
	СтруктураДокумента.Вставить("UUID_Документ",ДокументUUID); 
	СтруктураДокумента.Вставить("UUID_Сотрудник",ПараметрыСеанса.Сотрудник_ID);  
	СтруктураДокумента.Вставить("UUID_Принтер",ИД_Принтер);
	СтруктураДокумента.Вставить("КоличествоСтикеров",КолВоСтик);

	Если Не ПустаяСтрока(ДокументПеремещениеUUID) Тогда
		СтруктураДокумента.Вставить("UUID_Перемещение",ДокументПеремещениеUUID);
	КонецЕсли;
	
	СтруктураДокумента.Вставить("НомерУпаковки",КоробкаНомер);
	СтруктураДокумента.Вставить("НачалоУпаковки",КоробкаДатаОткрыта);
	СтруктураДокумента.Вставить("КонецУпаковки",ТекущаяДата());
	СтруктураДокумента.Вставить("Товары",МассивТовары);      
	
	
	Если ТипДокумента ="КомплектовщикОтбор" Тогда
		парамЗапрос = "DocTUPvol";	
	Иначе
		парамЗапрос = "DocTUP";	
	КонецЕсли;
	
	
	ТекстЗапроса = "/Complect/"+ПараметрыСеанса.UUID+"/"+парамЗапрос;
	РезОтвет = КомплектовщикТК.ОтправитьНаСервер(СтруктураДокумента,ТекстЗапроса);
	Если РезОтвет.Результат Тогда 
		ДокументПеремещениеUUID = РезОтвет.Ответ.UUID_Перемещение;	
		Возврат Истина;
	Иначе
		Если Не ПустаяСтрока(РезОтвет.ОписаниеОшибки) Тогда
			Сообщить(РезОтвет.ОписаниеОшибки);
		Иначе
			Сообщить("Помилка вивантаження документа!");	  
		КонецЕсли;    
		ДокументПеремещениеUUID = "";
        Возврат Ложь;
	КонецЕсли;
	
	
КонецФункции


