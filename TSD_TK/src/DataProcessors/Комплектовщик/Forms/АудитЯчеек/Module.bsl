&НаСервере
Функция ВзятьВРаботуНаСервере()

    ТекстЗапроса = "/Complect/" + ПараметрыСеанса.UUID + "/auditrab?uuidcom=" + ПараметрыСеанса.Сотрудник_ID
        + "&uuiddoc=" + ДокументUUID;
    ;
    РезОтвет = КомплектовщикТК.ПодготовитьGETЗапрос(ТекстЗапроса);
    Если РезОтвет.Результат Тогда
        ВРаботе = Истина;
        УстановитьДоступностьПоНастройкам();
        ДатаНачалаАудита = ТекущаяДатаСеанса();
    Иначе
        Если Не ПустаяСтрока(РезОтвет.ОписаниеОшибки) Тогда
            ОбщегоНазначенияКлиентСервер.СообщитьПользователю(РезОтвет.ОписаниеОшибки);
        КонецЕсли;

    КонецЕсли;

    Возврат ВРаботе

