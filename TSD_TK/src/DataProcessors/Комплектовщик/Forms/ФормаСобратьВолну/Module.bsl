КонецПроцедуры

&НаСервере
Функция ОтменитьСборкуРезерва()

    стрВозврат = Новый Структура("КоличествоРезервов,Отменен", 0, Ложь);
    текстЗапроса = "/Complect/" + ПараметрыСеанса.UUID + "/volnaotmena?uuiddoc=" + ДокументUUID + "&uuidcom="
        + ПараметрыСеанса.Сотрудник_ID;

    РезОтвет = КомплектовщикТК.ПодготовитьGETЗапрос(текстЗапроса);
    Если РезОтвет.Результат Тогда
        ДокументUUID ="";
        стрВозврат.КоличествоРезервов = РезОтвет.Ответ.ОчередьСборки;
        стрВозврат.Отменен = Истина;

    Иначе
        Если Не ПустаяСтрока(РезОтвет.ОписаниеОшибки) Тогда
            Сообщить(РезОтвет.ОписаниеОшибки);
        Иначе
            Сообщить("Помилка скасування резерву!");
        КонецЕсли;

    КонецЕсли;
    Возврат стрВозврат;
КонецФункции
&НаКлиенте
Процедура ЗакрытьКоробку(Команда)
    ВсегоВКоробке = ВсегоТекВведеноУпаковщик(Ложь, Истина);

    Если ВсегоВКоробке = 0 Тогда
        Сообщить("Візок порожній");
        Возврат;
    КонецЕсли;

    ИдетПроцессСканированияТелеги = Истина;
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаУпаковкаКоробка", "Видимость",
        Истина);
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаКнопки,ГруппаДокумент", "Видимость",
        Ложь);
КонецПроцедуры
&НаКлиенте
Процедура ДобавитьКолВоУпаковщик()

    ТекКолВВод = ТекКоличествоВведено;
    ВсегоВведено = ТекКолВВод + ВсегоТекВведеноУпаковщик() - ВсегоТекВведеноУпаковщик(Истина);

    Если ВсегоВведено > ТекКоличество Тогда
        Сообщить("перевищення! - " + Формат(ВсегоВведено - ТекКоличество, "ЧЦ=15; ЧДЦ=3"));
        Возврат;
    КонецЕсли;
    Если ТекиспХарактеристика = 1 Тогда

        ВыбратьМРЦ_Асинх(ТекХарактеристика, ТекАртикул, ТекКоэффициент, Истина);
        Возврат;
    КонецЕсли;

    отборКоробка = Новый Структура("Артикул,КоробкаНомер", ТекАртикул, КоробкаНомер);

    мУпаковщик = ТаблицаТоварыУпаковщик.НайтиСтроки(отборКоробка);
    Если мУпаковщик.Количество() Тогда
        смУпаковка = мУпаковщик[0];
    Иначе
        смУпаковка = ТаблицаТоварыУпаковщик.Добавить();
        смУпаковка.Артикул = ТекАртикул;
        смУпаковка.Характеристика = ТекХарактеристика;
        смУпаковка.КоробкаНомер = КоробкаНомер;
    КонецЕсли;

    смУпаковка.КоличествоВведено = ТекКолВВод;
    смУпаковка.Коэффициент = ТекКоэффициент;
    смУпаковка.Телега = ТекТелега;
    ТекКоличествоВведеноКоробка = ВсегоТекВведеноУпаковщик();
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ДекорацияПерейти", "Видимость",
        ТекКоличествоВведеноКоробка = ТекКоличество);

КонецПроцедуры

&НаКлиенте
