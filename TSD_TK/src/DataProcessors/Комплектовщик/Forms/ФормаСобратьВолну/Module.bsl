#Область ОписаниеПеременных

&НаКлиенте
Перем ВыполняетсяЗакрытие;

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса, ДопоплнительныеПараметры) Экспорт

    Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
        ВыполняетсяЗакрытие = Истина;
        Закрыть();
    КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Если Параметры.Свойство("АвтоТест") Тогда
        Возврат;
    КонецЕсли;
    ИнициализироватьКонстантыФормы();
    ОбновитьПодразделение();
    ОбновитьСотрудника();
    НастроитьФормуПоЗначениямНастроек();
    Отказ = Отказ Или ВзятьРезервНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
    ВыполняетсяЗакрытие = Ложь;

#Если МобильноеПриложениеКлиент Тогда
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "Сканировать", "Видимость", Ложь);
#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

    Если ЗначениеЗаполнено(ДокументUUID) Тогда
        Отказ = Истина;
        Возврат;
    КонецЕсли;

    Если Не ВыполняетсяЗакрытие Тогда
        Отказ = Истина;
        ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), "Завершити відбір?",
            РежимДиалогаВопрос.ДаНет);
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

    Если ПодключаемоеОборудованиеКлиент.ЭтоОповещениеСканераШтрихкода(ИмяСобытия) И ВводДоступен() Тогда

        ДополнительныеПараметры = Новый Структура;
        ДополнительныеПараметры.Вставить("Форма", ЭтотОбъект);
        Если ИдетПроцессСканированияТелеги Тогда
            ОбработатьШтрихкодТелеги(Параметр, ДополнительныеПараметры);
        Иначе
            ОбработатьПолученныйШтрихкод(Параметр, ДополнительныеПараметры);
        КонецЕсли;

    КонецЕсли;

КонецПроцедуры
#КонецОбласти
#Область СлужебныеПроцедурыИФункции

#Область ОбработкаШтрихкодов
&НаКлиенте
Процедура ОбработатьПолученныйШтрихкод(ПолученныйШтрихкод, Параметры) Экспорт

    Если ПустаяСтрока(ПолученныйШтрихкод) Тогда
        Возврат;
    КонецЕсли;

    Если ИД_Статус <> 1 Тогда
        Возврат;
    КонецЕсли;

    Если ИдетПроцессСканированияТелеги Тогда
        ОбработатьШтрихкодТелеги(ПолученныйШтрихкод, Параметры);

        Возврат;
    КонецЕсли;
    ТквВведено = ТекКоличествоВведеноКоробка;
    Если ТквВведено = ТекКоличество Тогда
        ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Кількість відібрано, перейдіть до наступного");
        Возврат;
    КонецЕсли;

    НСтркиШтрихКод = ТаблицаШтрихКода.НайтиСтроки(Новый Структура("ШтрихКод", ПолученныйШтрихкод));
    
    //Если ТекПроизводитель <> 0 И (ТекидУпаковка  = 2 Или ТекидУпаковка  = 3) Тогда //ФМ/БАТ Блоки,Ящики, 
    //  
    //  ЭтоИсключение = Ложь;
    //  Если нСтркиШтрихКод.Количество() > 0 И нСтркиШтрихКод[0].Артикул = ТекАртикул Тогда
    //      ЭтоИсключение = ПроверитьИсключение(ТекАртикул);    
    //  КонецЕсли;
    //  Если НЕ ЭтоИсключение Тогда
    //      ОбработатьШтрихКодФМ_БАТ(ПолученныйШтрихкод,Параметры); 
    //      Возврат;
    //  КонецЕсли;
    //КонецЕсли;
    ПоМаскеШтрихКода = Ложь;
    Если нСтркиШтрихКод.Количество() = 0 Тогда
        СтрШтрихКод = Новый Структура;
        СтрШтрихКод.Вставить("Штрихкод", ПолученныйШтрихкод);
        СтрШтрихКод.Вставить("Количество", 1);
        СтрШтрихКод.Вставить("Коэффициент", 1);
        СтрШтрихКод.Вставить("КодВесовогоТовара", "");
        СтрШтрихКод.Вставить("ПрефиксВесовогоТовара", "");
        ОбработатьВесовойШтрихкод(СтрШтрихКод);
        Если ПустаяСтрока(СтрШтрихКод.КодВесовогоТовара) Тогда
            ОбщегоназначенияКлиентСервер.СообщитьПользователю("У документі немає товару з цим штрихкодом - "
                + ПолученныйШтрихкод);
            Возврат;
        Иначе

            Если Не СтрШтрихКод.КодВесовогоТовара = ТекАртикул Тогда
                ОбщегоназначенияКлиентСервер.СообщитьПользователю("Ваговий артикул не належить товару - "
                    + ТекНаименованиеТовара);
                Возврат;
            КонецЕсли;

            ПоМаскеШтрихКода = Истина;
        КонецЕсли;
    КонецЕсли;
    Если Не ПоМаскеШтрихКода Тогда
        СтрШтрихКод = нСтркиШтрихКод[0];
        Если Не СтрШтрихКод.Артикул = ТекАртикул Тогда
            ОбщегоназначенияКлиентСервер.СообщитьПользователю("Штрихкод не належить товару - " + ТекНаименованиеТовара);
            Возврат;
        КонецЕсли;
    КонецЕсли;

    Если ТекШтрихКодОтсканирован = Ложь Тогда
        ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ДекорацияСканироватьКодТовара",
            "Видимость", Ложь);
        ТаблицаТовары[СтрокаТовараТекущая - 1].ШтрихКодОтсканирован = Истина;

    КонецЕсли;
    ТекШтрихКодОтсканирован = Истина;   
    //11.09.2025 - Ивченко Ольга Александровна <Olga.Ivchenko@digma.ua>
    //ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ТекКоличествоВведено,ДобавитьКолВо", "Доступность", ТекШтрихКодОтсканирован);
    //11.09.2025 - Ивченко Ольга Александровна <Olga.Ivchenko@digma.ua>
    // 02.07.2025 - ввод количества если больеш 25 шт
    // ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(Этотобъект, "ТекКоличествоВведено,ДобавитьКолВо", "Доступность", ТекКоличество >3);

    Если ТекКоэффициент = СтрШтрихКод.Коэффициент Тогда
        НовКоличество = ?(ПоМаскеШтрихКода, СтрШтрихКод.Количество, 1);

    Иначе
        НовКоличество = СтрШтрихКод.Коэффициент / ?(ТекКоэффициент = 0, 1, ТекКоэффициент);
    КонецЕсли;

    Если ТекВесовой = 0 И новКоличество < 1 Тогда
        ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не можна додати " + новКоличество + " відскануйте штрихкод "
            + ТекУпаковка + Символы.ПС + "Додайте кількість в ручну");
        Возврат;
    КонецЕсли;

    Если ТекВесовой И ТекКоличествоВведеноКоробка + новКоличество > ТекКоличество Тогда
        ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не можна додати " + новКоличество);
        Возврат;

    КонецЕсли;

    Если ТекиспХарактеристика = 1 Тогда
        ВыбратьМРЦ_Асинх(ТекХарактеристика, ПолученныйШтрихкод, СтрШтрихКод.Коэффициент);
    Иначе  
         //Если ТекВесовой = 1 Тогда
         //    ТекКоличествоВведеноВес = ТекКоличествоВведеноВес + новКоличество ;
         //Иначе
        ТекКоличествоВведено = ТекКоличествоВведено + новКоличество;
         //КонецЕсли; 

        МУпаковщик = ТаблицаТоварыУпаковщик.НайтиСтроки(Новый Структура("Артикул,КоробкаНомер", ТекАртикул,
            КоробкаНомер));
        Если МУпаковщик.Количество() Тогда
            СмУпаковка = мУпаковщик[0];
        Иначе
            СмУпаковка = ТаблицаТоварыУпаковщик.Добавить();
            СмУпаковка.Артикул = ТекАртикул;
            СмУпаковка.КоробкаНомер = КоробкаНомер;

        КонецЕсли;

        СмУпаковка.КоличествоВведено = ТекКоличествоВведено;
        СмУпаковка.Коэффициент = ТекКоэффициент;
        СмУпаковка.Телега = ТекТелега;

        ТекКоличествоВведеноКоробка = ВсегоТекВведеноУпаковщик();
        ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ДекорацияПерейти", "Видимость",
            ТекКоличествоВведеноКоробка = ТекКоличество);

    КонецЕсли;

КонецПроцедуры
#КонецОбласти
#КонецОбласти
&НаКлиенте
Процедура ОбработатьШтрихкодТелеги(ПолученныйШтрихкод, Параметры) Экспорт

    Если ПустаяСтрока(ПолученныйШтрихкод) Тогда
        Возврат;
    КонецЕсли;

    Результат = ПроверитьТележку(ПолученныйШтрихкод);
    Если ПустаяСтрока(Результат.ТекстОшибки) И Результат.ТележкаРабочий Тогда
        ИдетПроцессСканированияТелеги = Ложь;
        КоробкаОткрыта = Истина;
        ТекТелега = ПолученныйШтрихкод;
        КоробкаНомер = КоробкаНомер + 1;
        ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма,
            "ГруппаДокумент,ГруппаКнопки,ГруппаЗакрытьКоробку", "Видимость", Истина);
        ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаУпаковкаКоробка", "Видимость",
            Ложь);
    Иначе
        Если Не ПустаяСтрока(Результат.ТекстОшибки) Тогда
            Сообщить(Результат.ТекстОшибки);
        Иначе
            Сообщить("Не вдалося відсканувати візок!");
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ВзятьРезервНаСервере()

    Если Не Инициализирован Или Не ПользовательИнициализирован Тогда
        Возврат Истина;
    КонецЕсли;
    текстЗапроса = "/Complect/" + ПараметрыСеанса.UUID + "/mrezervrab?uuidcom=" + ПараметрыСеанса.Сотрудник_ID;

    РезОтвет = КомплектовщикТК.ПодготовитьGETЗапрос(текстЗапроса);
    Если Не РезОтвет.Результат Тогда
        Если Не ПустаяСтрока(РезОтвет.ОписаниеОшибки) Тогда
            Сообщить(РезОтвет.ОписаниеОшибки);
        Иначе
            Сообщить("Помилка отримання резервів!");
        КонецЕсли;
        Возврат Истина;
    КонецЕсли;

    СтруктураДокумента = РезОтвет.Ответ;

    Если СтруктураДокумента.Товары.Количество() = 0 Тогда
        Сообщить("Нет товаров для сборки");
        Возврат Истина;
    КонецЕсли;

    Страрт = ТекущаяДата();
    ДокументUUID = СтруктураДокумента.ДокументUUID;
    дВес = СтруктураДокумента.Вес;
    дКоличествоБаз = СтруктураДокумента.КоличествоБаз;
    НачалоКонтроля = ТекущаяДата();
    Если СтруктураДокумента.Свойство("Порядок") Тогда
        Порядок  = "м-" + СтруктураДокумента.Порядок;
    КонецЕсли;
	
	
	//СтруктураДокумента.Свойство("КомплектовщикУпаковщик",КомплектовщикУпаковщик);
    КомплектовщикУпаковщик = Истина;

    Для Каждого стТовар Из СтруктураДокумента.Товары Цикл
        нстрТовар = ТаблицаТовары.Добавить();
        нстрТовар.Артикул = стТовар.Артикул;
        нстрТовар.ТоварнаяМарка = стТовар.ТоварнаяМарка;
        нстрТовар.НаименованиеТовара = стТовар.Номенклатура;
        нстрТовар.Упаковка           = стТовар.ЕдиницаИзмерения;
        нстрТовар.Характеристика    = стТовар.ЗначениеМРЦ;
        нстрТовар.испХарактеристика    = стТовар.испХарактеристика;

        нстрТовар.Коэффициент      = стТовар.Коэффициент;
        нстрТовар.Количество      = стТовар.Количество;
        нстрТовар.КоличествоБаз      = стТовар.КоличествоБаз;
        нстрТовар.Производитель      = стТовар.Производитель; //1-ФМ, 2-БАТ, 0-Все остальные
        нстрТовар.идУпаковка      = стТовар.идУпаковка;  //1 - баз ед.изм (шт, пачки), 2 - Упакавка (блоки) , 3 - ящики, 0 - непонятные
		//нстрТовар.ЗаказИД       = стТовар.ЗаказИД;
		//нстрТовар.СкладИД       = стТовар.СкладИД;
        нстрТовар.Весовой       = стТовар.Весовой;
        нстрТовар.МестоХранение = стТовар.НомерЯчейки;
        нстрТовар.Мест = стТовар.Мест;

    КонецЦикла;

    Для Каждого стШтрихКод Из СтруктураДокумента.ШтрихКода Цикл

        нстрШтрихКод = ТаблицаШтрихКода.Добавить();
        нстрШтрихКод.ШтрихКод = СокрЛП(стШтрихКод.ШтрихКод);
        нстрШтрихКод.Артикул = стШтрихКод.Артикул;
        нстрШтрихКод.Упаковка = стШтрихКод.Упаковка;
        нстрШтрихКод.Коэффициент = стШтрихКод.Коэффициент;

    КонецЦикла;

    СтрокаТовараВсего = ТаблицаТовары.Количество();
    СтрокаТовараТекущая = 1;
    стрТовары = ТаблицаТовары[0];

    ТекАртикул = стрТовары.Артикул;
    ТекВесовой = стрТовары.Весовой;
    ТекИдентификаторСтроки = стрТовары.ПолучитьИдентификатор();
    ТекКоличество = стрТовары.Количество;
    ТекКоличествоВведено = стрТовары.КоличествоВведено;

    ТекКоэффициент = стрТовары.Коэффициент;
    ТекМестоХранение = стрТовары.МестоХранение;
    ТекМестоХранениеИД = стрТовары.МестоХранениеИД;
    ТекТоварнаяМарка = стрТовары.ТоварнаяМарка;
    ТекНаименованиеТовара = стрТовары.НаименованиеТовара;
    ТекУпаковка	          = стрТовары.Упаковка;
    ТекХарактеристика     = стрТовары.Характеристика;
    ТекиспХарактеристика     = стрТовары.испХарактеристика;

    ТекПроизводитель      = стрТовары.Производитель; //1-ФМ, 2-БАТ, 0-Все остальные
    ТекидУпаковка         = стрТовары.идУпаковка;    //1 - баз ед.изм (шт, пачки), 2 - Упакавка (блоки) , 3 - ящики, 0 - непонятные 
    ТекМест         = стрТовары.Мест;
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ДекорацияДанныеУп", "Заголовок", "("
        + ТекУпаковка + "." + ТекКоэффициент + ") " + ТекМест);

    РучнойВводБезШтрикода = Ложь;  //11.09.2025 - Ивченко Ольга Александровна <Olga.Ivchenko@digma.ua>

    Если ТаблицаШтрихКода.НайтиСтроки(Новый Структура("Артикул", ТекАртикул)).Количество() = 0 И Не (ТекПроизводитель
        = 1 Или ТекПроизводитель = 2) ИЛИ  ТекКоличество > КомплектовщикТК_КлиентСервер.ДоступноБезСканирования() Тогда
        ТекШтрихКодОтсканирован = Истина;  //нет штрихкодов ввод вручную   
        РучнойВводБезШтрикода = Истина;
    Иначе
        ТекШтрихКодОтсканирован = стрТовары.ШтрихКодОтсканирован;
    КонецЕсли;
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект,
        "ТекКоличество,ТекКоличествоВведеноКоробка,ТекКоличествоВведено", "Формат", ?(ТекВесовой = 1, "ЧЦ=15; ЧДЦ=3",
        "ЧЦ=15; ЧДЦ=0"));	
   	//ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ТекКоличествоВведено", "Видимость", Истина );
	//ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ТекКоличествоВведеноВес", "Видимость", ТекВесовой = 1 ); 
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ГруппаСтрокаМРЦ", "Видимость",
        ТекиспХарактеристика = 1);
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ГруппаЗакрытьКоробку", "Видимость", Ложь);
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект,
        "ГруппаДокумент,ДекорацияПерейти,ГруппаШапкаДокумента,ГруппаУпаковкаКоробка", "Видимость", Ложь);
	
	//ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаДокумент,ГруппаЗадачиНаСборку", "Видимость", Ложь);
