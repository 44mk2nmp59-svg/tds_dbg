Функция ПолучитьМРЦ_НаОстатке(Знач АртикулТовара, Знач СкладUUID)

    текстЗапроса = "/Complect/" + ПараметрыСеанса.UUID + "/mrcost?uuidcom=" + ПараметрыСеанса.Сотрудник_ID + "&art="
        + АртикулТовара + "&skladuuid=" + СкладUUID;
    РезОтвет = КомплектовщикТК.ПодготовитьGETЗапрос(текстЗапроса);
    СписокОстаткиМРЦ = Новый СписокЗначений;
    Если РезОтвет.Результат Тогда

        Для Каждого стрОстМРЦ Из РезОтвет.Ответ.ОстаткиМРЦ Цикл
            СписокОстаткиМРЦ.Добавить(стрОстМРЦ.МРЦ, Формат(стрОстМРЦ.МРЦ, "ЧЦ=10; ЧДЦ=2; ЧРД=.; ЧН=Ноль") + " ост. "
                + Формат(стрОстМРЦ.Остаток, "ЧЦ=5; ЧДЦ=0; ЧН=Ноль"));
        КонецЦикла;

    КонецЕсли;

    Возврат СписокОстаткиМРЦ

