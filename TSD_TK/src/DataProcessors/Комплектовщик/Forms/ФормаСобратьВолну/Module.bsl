    ДобавитьКолВоУпаковщик();

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКолВо(Команда)

    колВоДобавить = ТекКоличество - ТекКоличествоВведеноКоробка;
    ТекКоличествоВведено = ТекКоличествоВведено + колВоДобавить;

    ДобавитьКолВоУпаковщик();

КонецПроцедуры
#Область Ввод_МРЦ
&НаКлиенте
Процедура ОбработатьШтрихКодФМ_БАТ(ПолученныйШтрихКод, Параметры)

    ЭтоШККороба 	= СтрДлина(ПолученныйШтрихкод) > 60 И Лев(ПолученныйШтрихкод, 3) = "010";
    ЭтоШКБлока 	= Не ЭтоШККороба И ((СтрДлина(ПолученныйШтрихкод) > 16 И (Лев(ПолученныйШтрихкод, 3) = "010" Или Лев(
        ПолученныйШтрихкод, 3) = "343")));	//тут

    Если ЭтоШККороба = Ложь И ЭтоШКБлока = Ложь Тогда
        Сообщить("Відскануйте штрих-код виробника");
        Возврат;
    КонецЕсли;
    Если Лев(ПолученныйШтрихкод, 3) = "010" Тогда
        текШтрихКод = Сред(ПолученныйШтрихкод, 4, 13);
    Иначе
        текШтрихКод = Сред(ПолученныйШтрихкод, 4, 8);
        Пока Лев(текШтрихКод, 1) = "0" Цикл
            текШтрихКод = Прав(текШтрихКод, СтрДлина(текШтрихКод) - 1);
        КонецЦикла;
    КонецЕсли;

    Если ТекПроизводитель = 1 Или ТекПроизводитель = 2 Тогда  // 1-PMU, 2-BAT 
        нмШтрихПроизв =  ТаблицаШтрихКодаПроизводителей.НайтиСтроки(Новый Структура("ДанныеШтрихКода",
            ПолученныйШтрихКод));
        Если нмШтрихПроизв.Количество() > 0 Тогда
            Сообщить("штрих-код виробника відскановано раніше");
            Возврат;
        КонецЕсли;
		
		//ПроверитьШтрихНаСервере
        Если ПроверитьШтрихКодПоставщикаНаСервере(ПолученныйШтрихКод) Тогда
            Сообщить("штрих-код виробника відскановано раніше");
            Возврат;
        КонецЕсли;

    КонецЕсли;
    знПолученныйШтрихкод = текШтрихКод;

    нСтркиШтрихКод = ТаблицаШтрихКода.НайтиСтроки(Новый Структура("ШтрихКод", знПолученныйШтрихкод));
    Если нСтркиШтрихКод.Количество() = 0 Тогда
        Сообщить("У документі немає товару з цим штрихкодом - " + ПолученныйШтрихкод);
        Возврат;
    КонецЕсли;

    СтрШтрихКод = нСтркиШтрихКод[0];
    Если Не СтрШтрихКод.Артикул = ТекАртикул Тогда
        Сообщить("Штрихкод не належить товару - " + ТекНаименованиеТовара);
        Возврат;
    КонецЕсли;
    ШтрихКодКоэффициент = СтрШтрихКод.Коэффициент;

    КодМРЦ = "";
    Если ТекПроизводитель = 1 Тогда //PMU
        Если ЭтоШКБлока Тогда
            КодМРЦ = Прав(ПолученныйШтрихКод, 11);
        КонецЕсли;
    ИначеЕсли ТекПроизводитель = 2 Тогда  //BAT
        Если ЭтоШКБлока Тогда
            КодМРЦ = Прав(ПолученныйШтрихКод, 8);
        ИначеЕсли ЭтоШККороба Тогда
            ПозицияМРЦ = СтрНайти(ПолученныйШтрихКод, "240", НаправлениеПоиска.СНачала, 14) + 3;
            Если ПозицияМРЦ > 3 Тогда
                КодМРЦ = Сред(ПолученныйШтрихКод, ПозицияМРЦ, 8);
            КонецЕсли;
        КонецЕсли;
    ИначеЕсли ТекПроизводитель = 3 Тогда  //JTI
        Если ЭтоШКБлока Тогда
            КодМРЦ = Прав(ПолученныйШтрихКод, 8);
        КонецЕсли;
    КонецЕсли;

    РазмерМРЦ = 0;
    Если Не ПустаяСтрока(КодМРЦ) Тогда
        РазмерМРЦ = ПолучитьМРЦ_ПоКоду(ТекАртикул, КодМРЦ);
    КонецЕсли;

    Если РазмерМРЦ = 0 Тогда // нужно выбрать мрц
        ВыбратьМРЦ_Асинх(РазмерМРЦ, ПолученныйШтрихКод, ШтрихКодКоэффициент);
    Иначе
        ОбработатьВводМРЦ(РазмерМРЦ, ПолученныйШтрихКод, ШтрихКодКоэффициент);
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВводМРЦ(РазмерМРЦ, ПолученныйШтрихКод, ШтрихКодКоэффициент, РучнойВвод = Ложь)

    Если РазмерМРЦ = 0 Тогда
        Сообщить("МРЦ не вибрано!");
        Возврат;
    КонецЕсли;

    Если РучнойВвод Тогда

        мСтрокиТоварМРЦ = ТаблицаШтрихКодаПроизводителей.НайтиСтроки(Новый Структура("Артикул", ТекАртикул));
        Если мСтрокиТоварМРЦ.Количество() = 0 Тогда
            НоваяСтрокаШКП = ТаблицаШтрихКодаПроизводителей.Добавить();
        ИначеЕсли мСтрокиТоварМРЦ.Количество() = 1 Тогда
            НоваяСтрокаШКП = мСтрокиТоварМРЦ[0];
        Иначе
            Для Каждого стрТоварМРЦ Из мСтрокиТоварМРЦ Цикл
                ТаблицаШтрихКодаПроизводителей.Удалить(стрТоварМРЦ);
            КонецЦикла;
            НоваяСтрокаШКП = ТаблицаШтрихКодаПроизводителей.Добавить();
        КонецЕсли;

        ТекХарактеристика = РазмерМРЦ;
        НоваяСтрокаШКП.идПроизводитель = ТекПроизводитель;
        НоваяСтрокаШКП.ДанныеШтрихКода = ПолученныйШтрихКод;
        НоваяСтрокаШКП.Артикул = ТекАртикул;
        НоваяСтрокаШКП.Характеристика = РазмерМРЦ;
        НоваяСтрокаШКП.КоличествоВведено = ТекКоличествоВведено;
        ; 

		
		мУпаковщик = ТаблицаТоварыУпаковщик.НайтиСтроки(Новый Структура("Артикул,КоробкаНомер", ТекАртикул,
            КоробкаНомер));
        Если мУпаковщик.Количество() Тогда
            смУпаковка = мУпаковщик[0];
        Иначе
            смУпаковка = ТаблицаТоварыУпаковщик.Добавить();
            смУпаковка.Артикул = ТекАртикул;
            смУпаковка.КоробкаНомер = КоробкаНомер;
        КонецЕсли;

        смУпаковка.КоличествоВведено = ТекКоличествоВведено;
        смУпаковка.Коэффициент = ТекКоэффициент;
        смУпаковка.Телега = ТекТелега;

        ТекКоличествоВведеноКоробка = ВсегоТекВведеноУпаковщик();
    Иначе
        Если ТекКоэффициент = ШтрихКодКоэффициент Тогда
            ДобавитьНовТекКоличествоВведено =  1;
        Иначе
            ДобавитьНовТекКоличествоВведено = ШтрихКодКоэффициент / ?(ТекКоэффициент = 0, 1, ТекКоэффициент);
        КонецЕсли;

        Если ДобавитьНовТекКоличествоВведено < 1 Тогда
            ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не можна додати " + ДобавитьНовТекКоличествоВведено
                + " відскануйте штрихкод " + ТекУпаковка);
            Возврат;
        КонецЕсли;
        НовТекКоличествоВведено = ТекКоличествоВведено + ДобавитьНовТекКоличествоВведено;

        Если НовТекКоличествоВведено > ТекКоличество Тогда
            Сообщить("Перевищено кількість відбору!");
            Возврат;
        КонецЕсли;

        ТекКоличествоВведено = НовТекКоличествоВведено;

        ТекХарактеристика = РазмерМРЦ;
        НоваяСтрокаШКП = ТаблицаШтрихКодаПроизводителей.Добавить();
        НоваяСтрокаШКП.идПроизводитель = ТекПроизводитель;
        НоваяСтрокаШКП.ДанныеШтрихКода = ПолученныйШтрихКод;
        НоваяСтрокаШКП.Артикул = ТекАртикул;
        НоваяСтрокаШКП.Характеристика = РазмерМРЦ;
        НоваяСтрокаШКП.КоличествоВведено = ДобавитьНовТекКоличествоВведено;

        мУпаковщик = ТаблицаТоварыУпаковщик.НайтиСтроки(Новый Структура("Артикул,КоробкаНомер", ТекАртикул,
            КоробкаНомер));
        Если мУпаковщик.Количество() Тогда
            смУпаковка = мУпаковщик[0];
        Иначе
            смУпаковка = ТаблицаТоварыУпаковщик.Добавить();
            смУпаковка.Артикул = ТекАртикул;
            смУпаковка.КоробкаНомер = КоробкаНомер;
        КонецЕсли;

        смУпаковка.КоличествоВведено = НовТекКоличествоВведено;
        смУпаковка.Коэффициент = ТекКоэффициент;
        смУпаковка.Телега = ТекТелега;

        ТекКоличествоВведеноКоробка = ВсегоТекВведеноУпаковщик();
    КонецЕсли;
    Если ТекКоличествоВведено = ТекКоличество Тогда
        ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ДекорацияПерейти", "Видимость", Истина);
        ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ДекорацияСканироватьКодТовара",
            "Видимость", Ложь);
    Иначе
        ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ДекорацияПерейти", "Видимость", Ложь);
        ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ДекорацияСканироватьКодТовара",
            "Видимость", Истина);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыбратьМРЦ_Асинх(РазмерМРЦ, ПолученныйШтрихКод, ШтрихКодКоэффициент, РучнойВвод = Ложь)
    СписокОстаткиМРЦ = ПолучитьМРЦ_НаОстатке(ТекАртикул, СкладUUID);
    Если СписокОстаткиМРЦ.Количество() = 0 Тогда
        Сообщить("Немає залишку");
        Возврат;
    КонецЕсли;

    Обещание = СписокОстаткиМРЦ.ВыбратьЭлементАсинх("МРЦ");
    Рез = Ждать Обещание;
    Если Рез = Неопределено Тогда
        РазмерМРЦ = 0;
    Иначе
        РазмерМРЦ = Рез.Значение;
    КонецЕсли;
    ОбработатьВводМРЦ(РазмерМРЦ, ПолученныйШтрихКод, ШтрихКодКоэффициент, РучнойВвод);

КонецПроцедуры

