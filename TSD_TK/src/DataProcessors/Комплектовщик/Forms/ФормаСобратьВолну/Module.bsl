        ТаблицаРасхождений.Количество() > 0);
КонецПроцедуры
&НаКлиенте
Процедура ОбработатьПереходКнопкиВпередНазад(текСтрокаТовара)
    ТекАртикул = текСтрокаТовара.Артикул;
    ТекВесовой = текСтрокаТовара.Весовой;
    ТекИдентификаторСтроки = текСтрокаТовара.ПолучитьИдентификатор();
    ТекКоличество = текСтрокаТовара.Количество;
    ТекКоличествоВведено = текСтрокаТовара.КоличествоВведено;
    ТекКоэффициент = текСтрокаТовара.Коэффициент;
    ТекМестоХранение = текСтрокаТовара.МестоХранение;
    ТекМестоХранениеИД = текСтрокаТовара.МестоХранениеИД;
    ТекТоварнаяМарка = текСтрокаТовара.ТоварнаяМарка;
    ТекНаименованиеТовара = текСтрокаТовара.НаименованиеТовара;
    ТекУпаковка	          = текСтрокаТовара.Упаковка;
    ТекХарактеристика     = текСтрокаТовара.Характеристика;
    ТекиспХарактеристика  = текСтрокаТовара.испХарактеристика;

    ТекПроизводитель      = текСтрокаТовара.Производитель;  //1-ФМ, 2-БАТ, 0-Все остальные
    ТекидУпаковка         = текСтрокаТовара.идУпаковка;    //1 - баз ед.изм (шт, пачки), 2 - Упакавка (блоки) , 3 - ящики, 0 - непонятные 
    ТекМест               = текСтрокаТовара.Мест;
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ДекорацияДанныеУп", "Заголовок", "("
        + ТекУпаковка + "." + ТекКоэффициент + ") " + ТекМест);

    РучнойВводБезШтрикода = Ложь;
    Если ТаблицаШтрихКода.НайтиСтроки(Новый Структура("Артикул", ТекАртикул)).Количество() = 0 И Не (ТекПроизводитель
        = 1 Или ТекПроизводитель = 2) ИЛИ ТекКоличество > КомплектовщикТК_КлиентСервер.ДоступноБезСканирования() Тогда
        ТекШтрихКодОтсканирован = Истина;
        РучнойВводБезШтрикода  = Истина;   //нет штрихкодов ввод вручную 
    Иначе

        ТекШтрихКодОтсканирован = текСтрокаТовара.ШтрихКодОтсканирован;
    КонецЕсли;

    Если ТекиспХарактеристика = 1 Тогда
        нстрокиМРЦ =  ТаблицаШтрихКодаПроизводителей.НайтиСтроки(Новый Структура("Артикул", ТекАртикул));
        счМРЦ = 0;
        Для Каждого стрнстрокиМРЦ Из нстрокиМРЦ Цикл
            счМРЦ = счМРЦ + стрнстрокиМРЦ.КоличествоВведено;
            ТекХарактеристика = стрнстрокиМРЦ.Характеристика;
        КонецЦикла;
        ТекКоличествоВведено = счМРЦ;
    КонецЕсли;
	
	//Итого по товару
    нСтрокиУпаковщик = ТаблицаТоварыУпаковщик.НайтиСтроки(Новый Структура("Артикул", ТекАртикул));
    ТекКоличествоВведеноКоробка = 0;
    Для Каждого стрУпаковщик Из нСтрокиУпаковщик Цикл
        ТекКоличествоВведеноКоробка = ТекКоличествоВведеноКоробка + стрУпаковщик.КоличествоВведено;
    КонецЦикла;
    нСтрокиУпаковщик = ТаблицаТоварыУпаковщик.НайтиСтроки(Новый Структура("Артикул,КоробкаНомер", ТекАртикул,
        КоробкаНомер));
	//Итого по коробке упаковщика
    текКолКоробкаНом = 0;
    Для Каждого стрУпаковщик Из нСтрокиУпаковщик Цикл
        текКолКоробкаНом = текКолКоробкаНом + стрУпаковщик.КоличествоВведено;
    КонецЦикла;

    ТекКоличествоВведено = текКолКоробкаНом;	
	//ТекКоличествоВведеноВес = текКолКоробкаНом;
    ОбщегоНазначенияКлиентСервер.ОформитьКоличественныеПоляВвода(ЭтотОбъект,
        "ТекКоличество,ТекКоличествоВведено,ТекКоличествоВведеноКоробка", ТекВесовой = 1);
	//ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ТекКоличество,ТекКоличествоВведено,ТекКоличествоВведеноКоробка", "Формат", ?(ТекВесовой = 1,"ЧЦ=15; ЧДЦ=3; ЧН=0,000","ЧЦ=15; ЧДЦ=0; ЧН=0"));	
	//ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ТекКоличествоВведено", "Видимость", ТекВесовой = 0 );
	//ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ТекКоличествоВведеноВес", "Видимость", ТекВесовой = 1 );


    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект,
        "ГруппаСтрокаТовара,ГруппаСтрокаТовараОтборЕдиница,ГруппаКнопки", "Видимость", Истина);
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ГруппаСтрокаМРЦ", "Видимость",
        ТекиспХарактеристика = 1);

    Если ТекПроизводитель = 0 Тогда
        ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ТекКоличествоВведено,ДобавитьКолВо",
            "Доступность", РучнойВводБезШтрикода);
        ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ДекорацияСканироватьКодТовара",
            "Видимость", ТекШтрихКодОтсканирован = Ложь);
    Иначе
        ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ТекКоличествоВведено", "Доступность",
            ТекПроизводитель = 0);
        ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ДекорацияСканироватьКодТовара",
            "Видимость", ТекПроизводитель <> 0);
    КонецЕсли;

    ТекКоличествоВведеноВесШт = ТекКоличествоВведено;
    Если ТекКоличествоВведеноВесШт = ТекКоличество Тогда
        ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ДекорацияСканироватьКодТовара",
            "Видимость", Ложь);
    КонецЕсли;

    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ДекорацияПерейти", "Видимость",
        ТекКоличествоВведеноКоробка = ТекКоличество);
КонецПроцедуры
