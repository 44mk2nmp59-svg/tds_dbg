    Режим = РежимДиалогаВопрос.ДаНет;
    Ответ = Ждать ВопросАсинх("Скасувати відбір резерву?", Режим, 0);
    Если Ответ = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
    ИД_Статус = 0;
    РезОтмена =	ОтменитьСборкуРезерва();
    Если РезОтмена.Отменен Тогда
        ВыполняетсяЗакрытие = Истина;
        Закрыть(РезОтмена);
