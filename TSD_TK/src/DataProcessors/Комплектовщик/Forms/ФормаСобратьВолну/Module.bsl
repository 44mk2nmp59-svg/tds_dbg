Процедура ОбработатьПереходВперед()

    МестоХраненияОтсканировано = Ложь;
    текСтрокатовары = ТаблицаТовары.НайтиПоИдентификатору(ТекИдентификаторСтроки);
    текСтрокатовары.КоличествоВведено = ВсегоТекВведеноУпаковщик();//?(ТекВесовой = 0,ТекКоличествоВведено,ТекКоличествоВведеноВес);		
    текСтрокатовары.Отобрано = текСтрокатовары.Количество = текСтрокатовары.КоличествоВведено;
    текСтрокатовары.ШтрихКодОтсканирован = ТекШтрихКодОтсканирован;
    СтрокаТовараТекущая = СтрокаТовараТекущая + 1;

    Если СтрокаТовараТекущая <= СтрокаТовараВсего Тогда
        новСтрокатовары = ТаблицаТовары[СтрокаТовараТекущая - 1];
        ОбработатьПереходКнопкиВпередНазад(новСтрокатовары);

    Иначе
        СтрокаТовараТекущая = СтрокаТовараТекущая - 1;
        ТаблицаРасхождений.Очистить();
        мНеОтобранныеСтроки =  ТаблицаТовары.НайтиСтроки(Новый Структура("Отобрано", Ложь));
