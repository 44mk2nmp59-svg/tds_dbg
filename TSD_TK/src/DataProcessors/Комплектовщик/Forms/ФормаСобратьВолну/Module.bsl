&НаКлиенте
Асинх Процедура ЗакончитьОтборАсинх()
    Режим = РежимДиалогаВопрос.ДаНет;
    Ответ = Ждать ВопросАсинх("Закінчити відбір", Режим, 0);
    Если Ответ = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

    РезультатВыгрузки = ВыгрузитьРезультатыСканирования();
    Если РезультатВыгрузки.Успешно Тогда
        ВыполняетсяЗакрытие = Истина;
        Закрыть(РезультатВыгрузки);
    КонецЕсли;

КонецПроцедуры
&НаСервере
Функция ВыгрузитьРезультатыСканирования()

    СтруктураВозврат = Новый Структура("КоличествоРезервов,Успешно", 0, Ложь);

    МассивТовары = Новый Массив;
    ФиксСтруктура ="Артикул,Характеристика,Коэффициент,КоличествоВведено";
    Для Каждого стрТовар Из ТаблицаТовары Цикл
        Если стрТовар.КоличествоВведено = 0 Тогда
            Продолжить;
        КонецЕсли;
        СтруктураСтрока = Новый Структура(ФиксСтруктура);
        ЗаполнитьЗначенияСвойств(СтруктураСтрока, стрТовар);
        МассивТовары.Добавить(СтруктураСтрока);

    КонецЦикла;
    МассивТоварыПоТележкам = Новый Массив;
    ФиксСтруктура ="Артикул,Характеристика,Коэффициент,КоличествоВведено,Телега";

    Для Каждого стрТоварТелега Из ТаблицаТоварыУпаковщик Цикл
        Если стрТоварТелега.КоличествоВведено = 0 Тогда
            Продолжить;
        КонецЕсли;
        СтруктураСтрока = Новый Структура(ФиксСтруктура);
        ЗаполнитьЗначенияСвойств(СтруктураСтрока, стрТоварТелега);
        МассивТоварыПоТележкам.Добавить(СтруктураСтрока);

    КонецЦикла;            
	//МассивТоварыМРЦ = Новый Массив; 
	//ФиксСтруктура = "идПроизводитель,ДанныеШтрихКода,Артикул,Характеристика,КоличествоВведено";
	//Для Каждого стрТовар Из ТаблицаШтрихКодаПроизводителей Цикл 
	//	нстрокаСтруктура = Новый Структура(ФиксСтруктура);	
	//	ЗаполнитьЗначенияСвойств(нстрокаСтруктура,стрТовар);
	//	МассивТоварыМРЦ.Добавить(нстрокаСтруктура);
	//КонецЦикла;
    Если МассивТовары.Количество() = 0 Или МассивТоварыПоТележкам.Количество() = 0 Тогда
        Сообщить("Немає товарів для вивантаження");
        Возврат СтруктураВозврат;
    КонецЕсли;

    СтруктураДокумента = Новый Структура;
    СтруктураДокумента.Вставить("UUID_Документ", ДокументUUID);
    СтруктураДокумента.Вставить("UUID_Сотрудник", ПараметрыСеанса.Сотрудник_ID);
    СтруктураДокумента.Вставить("UUID_Телега", ТекТелега);
    СтруктураДокумента.Вставить("НачалоКонтроля", НачалоКонтроля);
    СтруктураДокумента.Вставить("Товары", МассивТовары);
    СтруктураДокумента.Вставить("ТоварыТележка", МассивТоварыПоТележкам);

    ТекстЗапроса = "/Complect/" + ПараметрыСеанса.UUID + "/DocVolnaFinih";
    РезОтвет = КомплектовщикТК.ОтправитьНаСервер(СтруктураДокумента, ТекстЗапроса);

    Если РезОтвет.Результат Тогда
        СтруктураВозврат.КоличествоРезервов = РезОтвет.Ответ.ОчередьСборки;
        СтруктураВозврат.Успешно = Истина;
        ДокументUUID ="";

    Иначе
        Если Не ПустаяСтрока(РезОтвет.ОписаниеОшибки) Тогда
            Сообщить(РезОтвет.ОписаниеОшибки);
        Иначе
            Сообщить("Помилка вивантаження документа!");
        КонецЕсли;

    КонецЕсли;
    Возврат СтруктураВозврат;

КонецФункции
&НаКлиенте
