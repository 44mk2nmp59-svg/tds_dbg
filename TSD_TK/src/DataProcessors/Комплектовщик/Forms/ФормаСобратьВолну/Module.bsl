            Для Каждого стрТоварыОт Из мНеОтобранныеСтроки Цикл
                стрТаблицаРасхождений = ТаблицаРасхождений.Добавить();
                ЗаполнитьЗначенияСвойств(стрТаблицаРасхождений, стрТоварыОт,
                    "НаименованиеТовара,Упаковка,Артикул,Коэффициент,Количество,КоличествоВведено,Весовой,КоличествоБаз");
                стрТаблицаРасхождений.ИдентификаторСтрокиТоваров = стрТоварыОт.ПолучитьИдентификатор();
            КонецЦикла;
			//	Иначе

        КонецЕсли;  
		
		//Если КоробкаОткрыта И ВсегоТекВведеноУпаковщик(Истина) Тогда
		//	
		//	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаКнопкаЗавершитьЗакрытьКоробку", "Видимость", Истина);	
		//	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаКнопкаЗак", "Видимость", Ложь);	
		//	
		//Иначе
			//ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаКнопкаЗавершитьЗакрытьКоробку", "Видимость", Ложь);	
        ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаКнопкаЗак", "Видимость", Истина);	
			
		//КонецЕсли;
		
		//Элементы.ГруппаШапкаДокумента.Показать();

        ПерейтиНаЗапросФормированияДокументов();

    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КнопкаВперед(Команда)
    Если ИД_Статус = 0 Тогда
        ИД_Статус = 1;

        Если КомплектовщикУпаковщик И Не КоробкаОткрыта Тогда
            ИдетПроцессСканированияТелеги = Истина;
            ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ГруппаУпаковкаКоробка",
                "Видимость", Истина);
            ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ГруппаКнопки,ГруппаТовары",
                "Видимость", Ложь);

        Иначе

            ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ГруппаТовары,ДекорацияПерейти",
                "Видимость", Ложь);	
			//ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ТекКоличество,ТекКоличествоВведено", "Формат", ?(ТекВесовой = 1,"ЧЦ=15; ЧДЦ=3","ЧЦ=15; ЧДЦ=0"));	
            ОбщегоНазначенияКлиентСервер.ОформитьКоличественныеПоляВвода(ЭтотОбъект,
                "ТекКоличество,ТекКоличествоВведено", ТекВесовой = 1);

            ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект,
                "ГруппаДокумент,ГруппаСтрокаТовара,ГруппаСтрокаТовараОтборЕдиница,ГруппаКнопки", "Видимость", Истина);
            ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ГруппаСтрокаМРЦ", "Видимость",
                ТекиспХарактеристика = 1);
            ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ДекорацияПерейти", "Видимость",
                ТекКоличествоВведеноКоробка = ТекКоличество);

        КонецЕсли;
        Возврат;
    КонецЕсли;

    тквВведено =  ТекКоличествоВведеноКоробка;
    Если тквВведено > ТекКоличество Тогда
        Сообщить("Перевищено кількість відбору!");
        Возврат;
    ИначеЕсли ТекКоличество > тквВведено Или тквВведено = 0 Тогда

        Режим = РежимДиалогаВопрос.ДаНет;
        Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтотОбъект, Параметры);
        ПоказатьВопрос(Оповещение, "Кількість введена менше ніж потрібно, перейти до наступного місця?", Режим, 0);
        Возврат;
    КонецЕсли;

    ОбработатьПереходВперед();

КонецПроцедуры

