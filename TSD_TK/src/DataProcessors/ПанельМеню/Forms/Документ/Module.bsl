&НаКлиенте
Процедура ОповещениеУстановитьКоличество(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено ИЛИ Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	ПодключаемоеОборудованиеКлиент.ОповещениеПоискаПоШтрихкодуПК(Результат,ДополнительныеПараметры);
	
КонецПроцедуры



&НаКлиенте
Процедура Подключаемый_ОчиститьНомерСтрокиДляПодсветки()
	
	НомерСтрокиДляПодсветки = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодсветитьСтроку(ИдентификаторСтроки)
	
	СтрокаТоваров = Объект.Товары.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если НЕ СтрокаТоваров = Неопределено Тогда
		НомерСтрокиДляПодсветки = СтрокаТоваров.НомерСтроки;
		Элементы.Товары.ТекущаяСтрока = ИдентификаторСтроки;
		
		
		Если НЕ ГоризонтальнаяОриентацияЭкрана Тогда
			
			Элементы.СтраницыПролистывания.ТекущаяСтраница = Элементы.СтраницаТовары;
			
		КонецЕсли;
		
		
		
		ИнтервалСек = 1;
		ПодключитьОбработчикОжидания("Подключаемый_ОчиститьНомерСтрокиДляПодсветки", ИнтервалСек,Истина);
	КонецЕсли;
	
КонецПроцедуры



&НаКлиенте
Процедура ОбработатьПолученныеДанные(ДанныеПоТовару, ДополнительныеПараметры,ПолученныйШтрихкод) Экспорт
	
	Если ДанныеПоТовару.Результат = ложь Тогда
		Сообщить(?(ЗначениеЗаполнено(ДанныеПоТовару.ОписаниеОшибки), ДанныеПоТовару.ОписаниеОшибки,"Данные по штрих коду не получены"));
		Возврат;
	КонецЕсли;
	СтруктураОтвета = ДанныеПоТовару.Ответ;
	
	
	Если Булево(СтруктураОтвета.ИспМРЦ) Тогда
		 ОткрытьДиалогВводаМРЦ(СтруктураОтвета);
	 Иначе
		 ОбработатьТоварВыбор(СтруктураОтвета)
	КонецЕсли;
	
Конецпроцедуры





&НаКлиенте
Процедура ОткрытьДиалогВводаМРЦ(СтруктураОтвета)
	
	
	Подсказка = НСтр("ru = '"+СтруктураОтвета.НаименованиеТовара+" МРЦ '");
	Подсказка = НСтр("ru = ' МРЦ '");
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗаголовокФормы", Подсказка);
	ПараметрыФормы.Вставить("ФорматРедактирования", "ЧЦ=15; ЧДЦ=2");

	
	Оповещение = Новый ОписаниеОповещения("ОповещениеВыбраноМРЦ", ЭтотОбъект,Новый Структура("Форма,СтруктураОтвета",ЭтаФорма,СтруктураОтвета));
	
	ОткрытьФорму("ОбщаяФорма.ВводЧисла", ПараметрыФормы, ЭтаФорма,,,,Оповещение);

	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьТоварВыбор(СтруктураОтвета,МРЦ="")
	
	ИдентификаторСтроки = ОпределитьСтроку(СтруктураОтвета.Артикул,МРЦ);
	ЗаполнитьСтроку(ИдентификаторСтроки, СтруктураОтвета,МРЦ);
	Если ВводкКоличества Тогда
		Элементы.Товары.ТекущаяСтрока = ИдентификаторСтроки;
		ТоварыВыбор(Неопределено,,,);
	Иначе
		
		ПодсветитьСтроку(ИдентификаторСтроки);
	КонецЕсли;
	

КонецПроцедуры



&НаКлиенте
Процедура ОповещениеВыбраноМРЦ(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено ИЛИ Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;  
	
	РезОтвет = ИнтеграцияТК_ВызовСервера.ПолучитьОстатокТовара(ДополнительныеПараметры.СтруктураОтвета.Артикул,Результат,СкладUUID);
	
	Если РезОтвет.Результат Тогда
		ДополнительныеПараметры.СтруктураОтвета.Вставить("Остаток",РезОтвет.Ответ.Остаток);
		Если РезОтвет.Ответ.Свойство("Продажа") Тогда 
		ДополнительныеПараметры.СтруктураОтвета.Вставить("Продажа",РезОтвет.Ответ.Продажа);
		КонецЕсли;
	КонецЕсли;
	
	ОбработатьТоварВыбор( ДополнительныеПараметры.СтруктураОтвета,Результат);	
	
КонецПроцедуры



&НаСервере
Процедура ЗаполнитьСтроку(ИдентификаторСтроки, ДанныеНоменклатуры,МРЦ = "")
	
	Строка = Объект.Товары.НайтиПоИдентификатору(ИдентификаторСтроки);
	ЗаполнитьЗначенияСвойств(Строка,ДанныеНоменклатуры,,"Количество,НаименованиеТовара");
	
	Если Строка.ИспМРЦ Тогда
		Строка.НаименованиеТовара = ДанныеНоменклатуры.НаименованиеТовара + " МРЦ - "+МРЦ+ " " +Строка.ШтрихКод;
		Строка.МРЦ = МРЦ;
	Иначе
		Строка.НаименованиеТовара = ДанныеНоменклатуры.НаименованиеТовара + " " +Строка.ШтрихКод;
	КонецЕсли;

	Если ДанныеНоменклатуры.Свойство("Остаток") Тогда
		Строка.Остаток = ДанныеНоменклатуры.Остаток;
	КонецЕсли;
	
	
	//
	Если НЕ ВводкКоличества Тогда
	//	
	//	Строка.Количество = Строка.Количество + 1;
	//Иначе
		Строка.Количество = Строка.Количество + ДанныеНоменклатуры.Количество;
	КонецЕсли;
	
	
	ОбновитьЗаписьПоСтроке(Строка);
	
КонецПроцедуры

&НаСервере
Функция ОпределитьСтроку(Артикул,МРЦ)
	
	НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("Артикул,МРЦ", Артикул,Строка(МРЦ)));
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		СтрокаТЧ = Объект.Товары.Добавить();
	Иначе
		СтрокаТЧ = НайденныеСтроки[0];
		
	КонецЕсли;
	
	Возврат СтрокаТЧ.ПолучитьИдентификатор();
	
КонецФункции

&НаСервере
Процедура ОбновитьЗаписьПоСтроке(Знач Строка, ИдентификаторСтроки = Неопределено)
	
	Если НЕ ИдентификаторСтроки = Неопределено Тогда
		СтрокаТЧ = Объект.Товары.НайтиПоИдентификатору(ИдентификаторСтроки);
	Иначе
		СтрокаТЧ = Строка;
	КонецЕсли;
	Если ВидДокумента = "ZAK" ИЛИ ВидДокумента = "PRIX" Тогда
		ЗаписьПоСтроке = НСтр("ru = 'Принято %Количество% из %Остаток%%ЕдИзм% Х %Коф%'");
		ЗаписьПоСтроке = СтрЗаменить(ЗаписьПоСтроке, "%Остаток%", Формат(СтрокаТЧ.Остаток, ЗначениеНастроекПовтИсп.ФорматКоличественныхПолей()));
		
	Иначе
		ЗаписьПоСтроке = НСтр("ru = '%Количество% из %Остаток%%ЕдИзм% Х %Коф% оп. прод.- %Продажи%'");
	КонецЕсли;
	 	нМрц = ?(СтрокаТЧ.ИспМРЦ," МРЦ - "+СтрокаТЧ.МРЦ,""); 	
		ЗаписьПоСтроке = СтрЗаменить(ЗаписьПоСтроке, "%Количество%", Формат(СтрокаТЧ.Количество, ЗначениеНастроекПовтИсп.ФорматКоличественныхПолей()));
		ЗаписьПоСтроке = СтрЗаменить(ЗаписьПоСтроке, "%Остаток%", Формат(СтрокаТЧ.Остаток, ЗначениеНастроекПовтИсп.ФорматКоличественныхПолей()));
		ЗаписьПоСтроке = СтрЗаменить(ЗаписьПоСтроке, "%ЕдИзм%",      Строка(СтрокаТЧ.НаименованиеЕдиницы));
		ЗаписьПоСтроке = СтрЗаменить(ЗаписьПоСтроке, "%Коф%",      Строка(СтрокаТЧ.Коэффициент)+""+нМрц);
		
		ЗаписьПоСтроке = СтрЗаменить(ЗаписьПоСтроке, "%Продажи%",      Формат(СтрокаТЧ.Продажи, ЗначениеНастроекПовтИсп.ФорматКоличественныхПолей()));


	СтрокаТЧ.ТоварыЗаписьПоСтроке = ЗаписьПоСтроке;
	
КонецПроцедуры


&НаКлиенте
Процедура СкладСписанияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
