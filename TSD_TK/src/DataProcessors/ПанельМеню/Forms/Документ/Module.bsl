		СтуктураОтвет.Ответ.ПоказатьВыборЭлемента(Оповещение,"Склад списания");
	Иначе
		Сообщить(СтуктураОтвет.ОписаниеОшибки);
	КонецЕсли;

	
КонецПроцедуры


