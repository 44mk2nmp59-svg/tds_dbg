Процедура ТоварыПередНачаломИзменения(Элемент, Отказ)
	Отказ = Истина;
	ТоварыВыбор(Элемент,,,);
КонецПроцедуры

&НаКлиенте
Процедура СтраницыПролистыванияПриСменеСтраницы(Элемент, ТекущаяСтраница)
	ОтключитьОбработчикПодсветки();
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьОбработчикПодсветки()
	ОтключитьОбработчикОжидания("Подключаемый_ОчиститьНомерСтрокиДляПодсветки");
КонецПроцедуры
	
&НаКлиенте
Процедура Отправить(Команда)
	
	
	Отказ = ПроверитьКорректность();
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Рез = ПередатьНаСервер();
	
	Если Рез.Результат Тогда
		
		Сообщить("Документ выгружен успешно");
		
		Если ВидДокумента = "ZAK" И  Объект.Товары.Количество()> 0 Тогда
			ПоказатьВопрос(Новый ОписаниеОповещения("ПослеПродолжениеПриема",ЭтотОбъект),"В документе остался не принятый товар, продолжить прием?",РежимДиалогаВопрос.ДаНет);
		Иначе
			ВыполняетсяЗакрытие = Истина;
			Закрыть(Новый Структура("УдалитьСтроку"));
		КонецЕсли;
	Иначе
		Сообщить("Ошибка отправки документа!"+Символы.ПС+Рез.ОписаниеОшибки);
	КонецЕсли;
	
 
КонецПроцедуры

&НаКлиенте
Функция  ПроверитьКорректность()
	Если ПустаяСтрока(СкладUUID) Тогда
		Сообщить("Не выбран склад");
		Возврат Истина;
	КонецЕсли;
	
	Если ВидДокумента ="IN" И ПустаяСтрока(КонтрагентUUID) тогда
		Сообщить("Контрагент не выбран");
		Возврат Истина;
	ИначеЕсли ВидДокумента ="Списание" И НЕ ЗначениеЗаполнено(СтатьяСписания) Тогда
		Сообщить("Укажите статью списания");
		Возврат Истина;
	ИначеЕсли 	 ВидДокумента ="ZAK" ИЛИ   ВидДокумента = "ПриемТовара" Тогда
		Если НЕ ЗначениеЗаполнено(ДатаДокумента) Тогда
			Сообщить("Укажите дату накладной");
			Возврат Истина;
		КонецЕсли;
	ИначеЕсли  ВидДокумента ="VOZ" Тогда
		//Если ПустаяСтрока(КонтрагентUUID) Тогда
		//	Сообщить("Контрагента не выбран");
		//	Возврат Истина;
		//КонецЕсли;
		Если ПустаяСтрока(СкладUUID) Тогда
			Сообщить("Склад не выбран");
			Возврат Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	
		
	Возврат Ложь;
	
КонецФункции




&НаСервере
Функция ПередатьНаСервер()
	
	СтруктураДокумента = Новый Структура();
	СтруктураДокумента.Вставить("UUID_Склад",СкладUUID);
	СтруктураДокумента.Вставить("ДоументСервер",ДоументСервер);
	
	Если ВидДокумента ="ZAK" Тогда
		СтруктураДокумента.Вставить("ДатаВхДокумента",Формат(ДатаДокумента,"ДФ=yyyyMMdd"));
		СтруктураДокумента.Вставить("НомерВхДокумента",НомерДокумента);
	ИначеЕсли ВидДокумента = "ПриемТовара"  Тогда
		СтруктураДокумента.Вставить("ID_Контрагента",Контрагенты.Код);
		СтруктураДокумента.Вставить("ДатаВхДокумента",Формат(ДатаДокумента,"ДФ=yyyyMMdd"));
		СтруктураДокумента.Вставить("НомерВхДокумента",НомерДокумента);
	ИначеЕсли ВидДокумента  = "IN" Тогда
		СтруктураДокумента.Вставить("UUID_Контрагента",КонтрагентUUID);
	ИначеЕсли ВидДокумента = "Списание" Тогда
		СтруктураДокумента.Вставить("Статья",СтатьяСписания.Код);
	ИначеЕсли ВидДокумента = "PRN" Тогда
		СтруктураДокумента.Вставить("ТипПеремещения",ТипПеремещения);
	ИначеЕсли ВидДокумента = "VOZ" Тогда
		СтруктураДокумента.Вставить("UUID_Контрагента",КонтрагентUUID);
	КонецЕсли;	
	
	
	Если ДоументСервер Тогда
		СтруктураДокумента.Вставить("ДокументUUID",ДокументUUID);
	КонецЕсли;
	
	МассивТоваров = Новый Массив;
	ПеремСтуктура = "Артикул,Коэффициент,Количество,НомерСтрокиДокумента"+?(ВидДокумента ="ZAK",",Остаток","")+?(ВидДокумента ="IN",",МРЦ","");
	
	Для Каждого СтрТовар Из Объект.Товары Цикл 
		Если СтрТовар.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураСтрока = Новый Структура(ПеремСтуктура);
		ЗаполнитьЗначенияСвойств(СтруктураСтрока,СтрТовар,ПеремСтуктура);
		МассивТоваров.Добавить(СтруктураСтрока);
		
	КонецЦикла;
	СтруктураДокумента.Вставить("Товары",МассивТоваров);
	
	Рез = ИнтеграцияТК_ВызовСервера.ПередатьДокументНаСервер(СтруктураДокумента,ВидДокумента);
	
	Если ВидДокумента = "ZAK" Тогда
		
		МассивСтрокДляУдаления = Новый Массив;
		Для Каждого СтрТовар Из Объект.Товары Цикл 
			нКоличество = 	СтрТовар.Остаток -  СтрТовар.Количество;
			Если нКоличество > 0 Тогда
				СтрТовар.Количество = 0;
				СтрТовар.Остаток = нКоличество;
				ОбновитьЗаписьПоСтроке(СтрТовар);
			Иначе
				МассивСтрокДляУдаления.Добавить(СтрТовар);
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого стрУдаления  Из МассивСтрокДляУдаления Цикл 
			Объект.Товары.Удалить(стрУдаления);
		КонецЦикла;
		
		
	КонецЕсли;
	

	
	Возврат Рез;
	
КонецФункции

&НаКлиенте
Процедура Расхождения(Команда)
	УстановитьРасхождения();
КонецПроцедуры
&НаСервере
Процедура УстановитьРасхождения()
	
	ПометкаВидимость = НЕ Элементы.ФормаРасхождения.Пометка;
	Элементы.ФормаРасхождения.Пометка = ПометкаВидимость;
	
	Если ПометкаВидимость Тогда
		Заголовок = "Все строки"
	Иначе
		Заголовок = "Только расхождения"
	КонецЕсли;
	
	уоВидимость = ЭтаФорма.УсловноеОформление.Элементы.Получить(0);
	уоВидимость.Использование = ПометкаВидимость;
	Элементы.ФормаРасхождения.Заголовок = Заголовок;
	
КонецПроцедуры


&НаКлиенте
Процедура ПолучитьКонтрагента(Команда)
	
	Если Не Инициализирован Тогда
		Сообщить("Устройство не инициализировано");
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Контрагент) Тогда
	    	ОчиститьРеквизиты("Контрагент");
		Иначе
			СтуктураОтвет =  ИнтеграцияТК_Клиент.ПолучитьКонтрагентаПоЕДРПО(Контрагент);
		Если СтуктураОтвет.Результат Тогда
			ЗаполнитьРеквизиты(СтуктураОтвет.Ответ,"Контрагент");
		Иначе
			 ОчиститьРеквизиты("Контрагент");
		 КонецЕсли;
	 КонецЕсли;

	
КонецПроцедуры

