
&НаКлиенте
Перем ВыполняетсяЗакрытие;


&НаСервере
Процедура ЗаполнитьДокумент(Отказ)
	
	ВидДокумента = Параметры.ВидДокумента;
	ДокументUUID = Параметры.ДокументUUID;
	ДатаДокумента = ТекущаяДата();
	Если ВидДокумента = "PRIX" Тогда
		НомерДокумента = Параметры.НомерДокумента;
	КонецЕсли;
	
	ДанныеДокумента = ИнтеграцияТК_ВызовСервера.ПолучитьДанныеДокумента(Параметры);
	 
	Если ДанныеДокумента.Результат Тогда
		
		Документ       = ДанныеДокумента.Ответ;
		Склад          = Документ.Sklad;
		СкладUUID      = Документ.SkladUUID;
		Контрагент     = Параметры.Контрагент;
		КонтрагентUUID = Параметры.КонтрагентUUID;
		
		Для Каждого СтрТовары Из Документ.Tovary Цикл 
			нСтрокаТовары = Объект.Товары.Добавить();
			нСтрокаТовары.Артикул 			  = СтрТовары.Art;
			нСтрокаТовары.НаименованиеТовара  = СтрТовары.Tovar;
			нСтрокаТовары.НаименованиеЕдиницы = СтрТовары.EdIzm;
			нСтрокаТовары.Коэффициент		  = СтрТовары.Kof;
			нСтрокаТовары.Количество 		  = 0;
			нСтрокаТовары.Остаток 			  = СтрТовары.Kol;
			ОбновитьЗаписьПоСтроке(нСтрокаТовары);
		КонецЦикла;
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаКонтрагент", "Доступность",Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "СкладСписания", "Доступность",Ложь);
	Элементы.СтраницыПролистывания.ТекущаяСтраница = Элементы.СтраницаТовары;

	Иначе
		Отказ = Истина;
		Сообщить("Ошибка получение данных с сервера" + Символы.ПС+ДанныеДокумента.ОписаниеОшибки);
	КонецЕсли;
	
	
КонецПроцедуры



&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	 		
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	Объект.Товары.Очистить();

	НастроитьФормуПоЗначениямНастроек();
	Если ВидДокумента = "ПриемТовара" Тогда
		ДатаДокумента = ТекущаяДата();
		НомерДокумента = "б/н";
		Контрагенты = Справочники.Контрагенты.АдмиралХФК;
	ИначеЕсли ВидДокумента ="IN" Тогда
		СтрСклад =   ИнтеграцияТК_ВызовСервера.ПолучитьДанныеСкладовПодразделения();
		Если СтрСклад.Результат И СтрСклад.Ответ.Количество()<>0 Тогда
			СтрокаСклад = СтрСклад.Ответ[0];
			СкладUUID = СтрокаСклад.Значение;
			Склад = СтрокаСклад.Представление;
		КонецЕсли;
		
	КонецЕсли;
	
	
	НастроитьФормуПоОриентацииЭкрана();
	Если Параметры.Свойство("ОбновитьДанные") Тогда
		ДоументСервер = Истина;
		ЗаполнитьДокумент(Отказ);
	КонецЕсли;
	
	

	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуПоЗначениямНастроек()
	
	ВводкКоличества = Истина;
		
//	ТипДокумента = Параметры.ТипДокумента;
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры,"ТипДокумента,ВидДокумента"); 
	Заголовок    = ТипДокумента;
	ИспользуетсяАсинхронныйСканер = ЗначениеНастроекВызовСервераПовтИсп.ИспользуетсяАсинхронныйСканерШтрихкодов();
	Инициализирован = НЕ ПустаяСтрока(ПараметрыСеанса.Подразделение);
	
	ОбщегоНазначения.УстановитьШрифт(ЭтаФорма);
	
	ОбщегоНазначения.УстановитьВысотуПоляНаименованиеТовара(ЭтаФорма,"ТоварыНаименованиеТовара");
	
	ОбновитьПодразделение();
	
	ЕстьОборудованиеСканирования = ЗначениеЗаполнено(ЗначениеНастроекВызовСервераПовтИсп.ТипУстройстваСканирования());

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "Сканировать", "Видимость",
		(ЕстьОборудованиеСканирования И НЕ ИспользуетсяАсинхронныйСканер) И Инициализирован
	);

	
	ВидимостьКонтрагент = Истина;
	ВидимостьКонтрагенты = Ложь;
	Если ВидДокумента = "Списание" Или ВидДокумента = "PRN" ИЛИ ВидДокумента = "ПриемТовара" Тогда
		ВидимостьКонтрагент = Ложь;
	КонецЕсли;
	
	Если  ВидДокумента = "ПриемТовара" Тогда
		ВидимостьКонтрагенты = Истина;
	КонецЕсли;

	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "Контрагенты", "Видимость",
		ВидимостьКонтрагенты

	);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаКонтрагент", "Видимость",
		ВидимостьКонтрагент

	);
	

	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаСписание", "Видимость",
		ВидДокумента = "Списание" 
	);


	ВидимостьНомерДата = Ложь;
	Если  ВидДокумента = "ПриемТовара" ИЛИ ВидДокумента ="PRIX"  ИЛИ ВидДокумента = "ZAK" Тогда
		ВидимостьНомерДата = Истина;
	КонецЕсли;
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаНомеДатаДокумента", "Видимость",
		ВидимостьНомерДата
	);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ГруппаТипПеремещения", "Видимость",
		ВидДокумента = "PRN"
	);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "ФормаРасхождения", "Видимость",
	ВидДокумента ="PRIX"  ИЛИ ВидДокумента = "ZAK"
	);

	НастроитьЭлементыАсинхронногоСканера();
	

	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПодразделение()
	
	Если ПустаяСтрока(ПараметрыСеанса.Подразделение) Тогда
		Элементы.СообщениеИнициализации.Заголовок = "Устройство не инициализировано";
		ОбщегоНазначения.УстановитьЦветПолейОшибок(ЭтаФорма, "СообщениеИнициализации");
		Склад = "";
		Инициализирован = Ложь;
		
	Иначе
		Если ПараметрыСеанса.Подразделение <> Элементы.СообщениеИнициализации.Заголовок Тогда
			Склад = "";
			СкладUUID = "";
		КонецЕсли;
		

		Элементы.СообщениеИнициализации.Заголовок = ПараметрыСеанса.Подразделение;
		ОбщегоНазначения.УстановитьЦветИнформационныхНадписей(ЭтаФорма, "СообщениеИнициализации");
		Инициализирован = Истина;
		
		
		
	КонецЕсли;
	
	ЕстьОборудованиеСканирования = ЗначениеЗаполнено(ЗначениеНастроекВызовСервераПовтИсп.ТипУстройстваСканирования());
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "Сканировать", "Доступность",
	(ЕстьОборудованиеСканирования И НЕ ИспользуетсяАсинхронныйСканер) И Инициализирован
	);

	
КонецПроцедуры


&НаСервере
Процедура НастроитьЭлементыАсинхронногоСканера()
	
	//АсинхронныйСканерИнициализирован = ПодключаемоеОборудованиеВызовСервера.СканерШтрихкодовИнициализирован();
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "АктивироватьСканер", "Видимость", 
		ИспользуетсяАсинхронныйСканер
	);
	
КонецПроцедуры


