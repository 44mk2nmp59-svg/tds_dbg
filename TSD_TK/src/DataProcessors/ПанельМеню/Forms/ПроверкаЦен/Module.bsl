        ДанныеПоТовару = ИнтеграцияТК_Клиент.ПолучитьДанныеПоТоваруКлиент(ПолученныйШтрихкод, , Истина);
    КонецЕсли;
    ОбработатьПолученныеДанные(ДанныеПоТовару, Параметры);

