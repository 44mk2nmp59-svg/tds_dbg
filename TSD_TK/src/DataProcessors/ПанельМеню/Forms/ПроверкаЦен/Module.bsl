&НаСервере
Процедура ОбработатьНовуюСтроку(ИдентификаторСтроки)
    ЗаписьПоСтроке = НСтр("ru = '%Артикул% %Номенклатура% %Еденица%'");
    ЗаписьПоСтрокеЦенаОстаток = НСтр("ru = 'Цена %Цена% ост. %Остаток%'");
    СтрокаТовара = Товары.НайтиПоИдентификатору(ИдентификаторСтроки);

    ЗаписьПоСтроке = СтрЗаменить(ЗаписьПоСтроке, "%Еденица%", Строка(СтрокаТовара.Еденица));
    ЗаписьПоСтроке = СтрЗаменить(ЗаписьПоСтроке, "%Артикул%", Строка(СтрокаТовара.Артикул));
    ЗаписьПоСтроке = СтрЗаменить(ЗаписьПоСтроке, "%Номенклатура%", Строка(СтрокаТовара.НаименованиеТовара));
    ЗаписьПоСтрокеЦенаОстаток = СтрЗаменить(ЗаписьПоСтрокеЦенаОстаток, "%Цена%", Формат(СтрокаТовара.Цена,
        ОбщегоНазначенияПовтИсп.ФорматСуммовыхПолей()));
    ЗаписьПоСтрокеЦенаОстаток = СтрЗаменить(ЗаписьПоСтрокеЦенаОстаток, "%Остаток%", Формат(СтрокаТовара.Остаток,
        ЗначениеНастроекПовтИсп.ФорматКоличественныхПолей()));
	//

    СтрокаТовара.ЗаписьПоСтроке = ЗаписьПоСтроке;
    СтрокаТовара.ЗаписьПоСтрокеЦенаОстаток = ЗаписьПоСтрокеЦенаОстаток;
    СтрокаНаименование = "[" + СтрокаТовара.Артикул + "]" + " " + "[" + СтрокаТовара.ШтрихКод + "]" + Символы.ПС
        + СтрокаТовара.НаименованиеТовара;
    Цена = Формат(СтрокаТовара.Цена, "ЧЦ=15; ЧДЦ=2; ЧН=");
    ЦенаЦенник = Формат(СтрокаТовара.ЦенаЦенник, "ЧЦ=15; ЧДЦ=2; ЧН=");
    Остаток = Формат(СтрокаТовара.Остаток, "ЧЦ=15; ЧДЦ=3; ЧН=");

    ОстатокТНП = Формат(СтрокаТовара.ОстатокТНП, "ЧЦ=15; ЧДЦ=3; ЧН=");

    Отсканировано = Товары.Количество();
    ОтсканированоНеПравильных = Товары.НайтиСтроки(Новый Структура("ЕстьСверка,БезЦенника,ЦенаПроверена", Истина, Ложь,
        Ложь)).Количество();
    ОтсканированоБезЦенников  = Товары.НайтиСтроки(Новый Структура("БезЦенника", Истина)).Количество();
    Если СтрокаТовара.ЕстьСверка И Не СтрокаТовара.БезЦенника И Не СтрокаТовара.ЦенаПроверена Тогда
        Подсветка = Истина;
    Иначе
        Подсветка = Ложь;
    КонецЕсли;
КонецПроцедуры
