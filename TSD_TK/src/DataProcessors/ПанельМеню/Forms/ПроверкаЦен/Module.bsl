&НаСервере
Функция ПередатьНаСерверНаСервере()
    МассивТоваров = Новый Массив;
    Для Каждого СтрТовары Из Товары Цикл
        Если (СтрТовары.ЕстьСверка И Не СтрТовары.ЦенаПроверена) Или СтрТовары.БезЦенника Тогда

            МассивТоваров.Добавить(Новый Структура("Артикул,МРЦ", СтрТовары.Артикул, ""));
        КонецЕсли;
    КонецЦикла;

    СтруктураДокумента = Новый Структура;
    СтруктураДокумента.Вставить("ТипДокумента", "ПечатьЦенников");
    СтруктураДокумента.Вставить("Товары", МассивТоваров);
    Ответ =  ИнтеграцияТК_ВызовСервера.ПередатьТоварыДляЦенников(СтруктураДокумента);
    Если Ответ.Результат Тогда
        Товары.Очистить();
        Отсканировано = Товары.Количество();
        ОтсканированоНеПравильных = 0;
        ОтсканированоБезЦенников  = 0;
        Подсветка = Ложь;
        СтрокаНаименование = "";
        Если ЗаданиеВерификации Тогда

            СтруктураДокумента = Новый Структура("UUID_Документ,ДоументСервер", ИД_Задания, Ложь);
            Рез = ИнтеграцияТК_ВызовСервера.ПередатьДокументНаСервер(СтруктураДокумента,
                Справочники.ТипыДокументов.ЗаданиеВФ);

            Возврат Рез.Результат;
        Иначе
            Сообщить("Отправлено на печать");

        КонецЕсли;
    Иначе
        Сообщить(Ответ.ОписаниеОшибки);
    КонецЕсли;

    Возврат Истина;

КонецФункции

&НаСервере
Функция ПолучитьТаблицуЦенниковДляПечати()

    Если ПечататьВсеЦенники Тогда
        тзТипыЦенников = Товары.Выгрузить( , "СпецЦена");
    Иначе

        тзТипыЦенников = Новый ТаблицаЗначений;
        тзТипыЦенников.Колонки.Добавить("СпецЦена");
        Для Каждого стрТовары Из Товары Цикл
            Если стрТовары.ЦенаПроверена = Ложь Или стрТовары.БезЦенника Тогда
                тзстрТипыЦенников =  тзТипыЦенников.Добавить();
                тзстрТипыЦенников.СпецЦена = стрТовары.СпецЦена;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    тзТипыЦенников.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0,
        ДопустимыйЗнак.Любой)));
    тзТипыЦенников.ЗаполнитьЗначения(1, "Количество");
    тзТипыЦенников.Свернуть("СпецЦена", "Количество");

    Возврат тзТипыЦенников;
КонецФункции

&НаСервере
Функция СписокЦенников()

    ТзТипыЦенников = ПолучитьТаблицуЦенниковДляПечати();
    ВариантыПечати = ПечатьЦенникиСервер.ПолучитьСписокВариантовПечати(тзТипыЦенников);

    Возврат ВариантыПечати;

КонецФункции
&НаКлиенте
Процедура ПередатьНаСервер(Команда)
    ВариантыПечати = СписокЦенников();
    Если ВариантыПечати.Количество() = 0 Тогда
        ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Немає цінників для друку");
        Возврат;
    КонецЕсли;

    ОповещениеПечати = Новый ОписаниеОповещения("ВыборВариантаПечатии", ЭтотОбъект, Новый Структура);

    ПоказатьВыборИзМеню(ОповещениеПечати, ВариантыПечати);

	//ПередатьНаСерверНаСервере();
КонецПроцедуры
&НаКлиенте
Процедура ВыборВариантаПечатии(ВариантыПечати, ПараметрыПечати) Экспорт
    Если ВариантыПечати = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Ответ = ПечатьНаСервере(ВариантыПечати.Значение);
    Если Ответ.Результат = Ложь Тогда
        Сообщить(Ответ.ОписаниеОшибки);
    Иначе
        Если ЗначениеНастроекВызовСервераПовтИсп.ИспользуетсяПечатьНаПринтер() Тогда
            ОбщегоНазначенияКлиент.ВывестиПДФ_НаПечать(Ответ.Ответ);
        Иначе
            Сообщить("Отправлено на печать");
        КонецЕсли;

    КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПечатьНаСервере(ТипЦены)
    МассивТоваров = Новый Массив;
    нТовары = Новый Массив;

    Для Каждого СтрТовары Из Товары Цикл

        Если СтрТовары.СпецЦена <> ТипЦены Тогда
            Продолжить;
        КонецЕсли;
        флПечать = Ложь;
        Если ПечататьВсеЦенники Тогда
            флПечать = Истина;
        ИначеЕсли СтрТовары.СпецЦена = ТипЦены И (стрТовары.ЦенаПроверена = Ложь Или стрТовары.БезЦенника) Тогда
            флПечать = Истина;
        КонецЕсли;

        Если флПечать Тогда
            МассивТоваров.Добавить(Новый Структура("Артикул,МРЦ", СтрТовары.Артикул, ""));
            нТовары.Добавить(СтрТовары);

        КонецЕсли;

    КонецЦикла;
    СтруктураДокумента = Новый Структура;
    СтруктураДокумента.Вставить("Товары", МассивТоваров);
    СтруктураДокумента.Вставить("ИД_Переоценки", ТипЦены);

    Если ЗначениеНастроекВызовСервераПовтИсп.ИспользуетсяПечатьНаПринтер() Тогда

        СтруктураДокумента.Вставить("ТипДокумента", "ПечатьЦенниковТСД");
        Ответ =  ИнтеграцияТК_ВызовСервера.ЗапросПечатнаяФорма(СтруктураДокумента);

    Иначе

        СтруктураДокумента.Вставить("ТипДокумента", "ПечатьЦенников");

        Ответ =  ИнтеграцияТК_ВызовСервера.ПередатьТоварыДляЦенников(СтруктураДокумента);
    КонецЕсли;

    Если Ответ.Результат Тогда

        Для Каждого СтрТовары Из нТовары Цикл
            Товары.Удалить(СтрТовары);
        КонецЦикла;

        Отсканировано = Товары.Количество();
        ОтсканированоНеПравильных = 0;
        ОтсканированоБезЦенников  = 0;
        ЦенаЦенник = 0;
        Подсветка = Ложь;
        СтрокаНаименование = "";
        Цена = 0;
        Остаток = 0;
        ОстатокТНП = 0;
    КонецЕсли;
    Возврат Ответ;

КонецФункции
