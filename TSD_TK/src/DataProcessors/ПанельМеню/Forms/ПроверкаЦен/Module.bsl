&НаКлиенте
Процедура ОбработатьПолученныеДанные(ДанныеПоТовару, ДополнительныеПараметры) Экспорт

    Если ДанныеПоТовару.Результат = Ложь Тогда
        Сообщить(?(ЗначениеЗаполнено(ДанныеПоТовару.ОписаниеОшибки), ДанныеПоТовару.ОписаниеОшибки,
            "Данные по штрих коду не получены"));
        ЗвукОшибки();

        Возврат;
    КонецЕсли;
    СтруктураОтвета = ДанныеПоТовару.Ответ;

    Если СтруктураОтвета.Свойство("АМ") Тогда
        ЦветАМ = ?(СтруктураОтвета.АМ = 0, WebЦвета.Красный, WebЦвета.Синий);
        Элементы.ДекорацияАМ.ЦветФона 		  = ЦветАМ;
    КонецЕсли;

    Если СтруктураОтвета.Свойство("СрокВозврата") Тогда
        УсловиеВозврата = СтруктураОтвета.СрокВозврата;
        ДатаВозврата = ?(УсловиеВозврата = 0, "ДО ПРОСРОКА", Формат(ТекущаяДата() + (60 * 60 * 24 * УсловиеВозврата),
            "ДФ=dd.MM.yy"));
    Иначе
        ДатаВозврата = Неопределено;
        УсловиеВозврата = 0;
    КонецЕсли;

    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ГруппаВозвр30", "Видимость",
        УсловиеВозврата = 30);
    нСтрока = Товары.Добавить();
    ЗаполнитьЗначенияСвойств(нСтрока, СтруктураОтвета);
    ИдентификаторСтроки = нСтрока.ПолучитьИдентификатор();
    ОбработатьНовуюСтроку(ИдентификаторСтроки);

#Если МобильноеПриложениеКлиент Тогда
    Если Подсветка Тогда
        ЗвукОшибки();
    КонецЕсли;
#КонецЕсли
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПоместитьМакетВоВременноеХранилище(ИмяМакета) Экспорт

