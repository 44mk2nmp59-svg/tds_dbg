&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Если Параметры.Свойство("АвтоТест") Тогда
        Возврат;
    КонецЕсли;

    Параметры.Свойство("ДокументUUID", ИД_Задания);
    Параметры.Свойство("ОписаниеЗадания", ОписаниеЗадания);

    Если Параметры.Свойство("ВидДокумента") Тогда
        ЗаданиеВерификации =  ?(Параметры.ВидДокумента = "ЗаданиеВФ", Истина, Ложь);
    КонецЕсли;
	
	//Если ЗаданиеВерификации Тогда
	//	ЗаполнитьДокумент(Отказ);
	//КонецЕсли;

    НастроитьФормуПоЗначениямНастроек();
	
	// ОриентацияЭкрана
    НастроитьФормуПоОриентацииЭкрана();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
    АсинхронныйСканерИнициализирован = ПодключаемоеОборудованиеВызовСервера.СканерШтрихкодовИнициализирован();

    Если ИспользуетсяАсинхронныйСканер И АсинхронныйСканерИнициализирован = Ложь Тогда
        ПодключитьОбработчикОжидания("Подключаемый_ПодключитьАссинхронныйСканерШтрихкодов", 0.1, Истина);
    КонецЕсли;

    ВыполняетсяЗакрытие = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПодключитьАссинхронныйСканерШтрихкодов()

    ИнициализироватьАсинхронныйСканер();

КонецПроцедуры
&НаСервере
Процедура НастроитьФормуПоЗначениямНастроек()
    ИспользуетсяАсинхронныйСканер = ЗначениеНастроекВызовСервераПовтИсп.ИспользуетсяАсинхронныйСканерШтрихкодов();
    Инициализирован = Не ПустаяСтрока(ПараметрыСеанса.Подразделение);
    ОбщегоНазначения.УстановитьШрифт(ЭтотОбъект);
    ОбновитьПодразделение();
    ЕстьОборудованиеСканирования = ЗначениеЗаполнено(ЗначениеНастроекВызовСервераПовтИсп.ТипУстройстваСканирования());

	//ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма, "Сканировать", "Доступность",
	//(ЕстьОборудованиеСканирования И НЕ ИспользуетсяАсинхронныйСканер) И Инициализирован
	//);
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ГруппаВозвр30", "Видимость", Ложь);
    ОбщегоНазначения.УстановитьВысотуПоляНаименованиеТовара(ЭтотОбъект, "СтрокаНаименование");
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "Сканировать", "Видимость",
        (ЕстьОборудованиеСканирования И Не ИспользуетсяАсинхронныйСканер) И Инициализирован);
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ГруппаТовары", "Видимость",
        ПоказатьСписок);
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ГруппаСканирование", "Видимость",
        Не ПоказатьСписок);

    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ФормаПередатьНаСервер,ОписаниеЗадания",
        "Видимость", Не ЗаданиеВерификации);
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "ФормаВыполнитьЗадание,ОписаниеЗадания",
        "Видимость", ЗаданиеВерификации);
    НастроитьЭлементыАсинхронногоСканера();
КонецПроцедуры

&НаСервере
Процедура ОбновитьПодразделение()

    Если ПустаяСтрока(ПараметрыСеанса.Подразделение) Тогда
        Элементы.СообщениеИнициализации.Заголовок = "Устройство не инициализировано";
        ОбщегоНазначения.УстановитьЦветПолейОшибок(ЭтотОбъект, "СообщениеИнициализации");
        Инициализирован = Ложь;
    Иначе
        Элементы.СообщениеИнициализации.Заголовок = ПараметрыСеанса.Подразделение;
        ОбщегоНазначения.УстановитьЦветИнформационныхНадписей(ЭтотОбъект, "СообщениеИнициализации");
        Инициализирован = Истина;

    КонецЕсли;
    ЕстьОборудованиеСканирования = ЗначениеЗаполнено(ЗначениеНастроекВызовСервераПовтИсп.ТипУстройстваСканирования());

    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтотОбъект, "Сканировать", "Доступность",
        (ЕстьОборудованиеСканирования И Не ИспользуетсяАсинхронныйСканер) И Инициализирован);
КонецПроцедуры

